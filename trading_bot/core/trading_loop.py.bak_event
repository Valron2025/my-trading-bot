"""Основной торговый цикл - сердце бота"""

import time
import asyncio
import threading
from datetime import datetime, time as dt_time
from typing import Optional, List, Dict, Any, Tuple

from ..config import config
from ..logger import info, success, error, warning, debug
from ..utils.time_utils import (
    get_moscow_time,
    is_pre_market_time,
    is_main_session_time,
    is_evening_session_time,
    is_technical_break,
    get_current_session_name_detailed,
    get_minutes_until_session_start
)
from trading_bot.models import OrderSide

from trading_bot.trading.position_closer import position_closer


def _get_tbank():
    from trading_bot.api.tbank_client import tbank
    return tbank


def _get_telegram():
    from trading_bot.telegram.telegram_notifier import get_telegram_notifier
    return get_telegram_notifier()


class TradingLoop:
    """Основной торговый цикл"""

    def __init__(self, bot):
        self.bot = bot
        self._running = False
        self._thread: Optional[threading.Thread] = None
        self._cycle_count = 0
        self._last_cycle_time = 0
        # Для оптимизации логирования
        self._last_short_status = None
        self._last_market_log_cycle = 0
        self._consecutive_errors = 0
        self._last_error_time = 0
        self._last_report_date = None
        self._current_session = "unknown"
        
        # Для очистки дубликатов
        self._last_cleanup_time = 0
        self._cleanup_cooldown = 60  # не чаще 1 раза в минуту

        # ========== WEBSOCKET ДЛЯ РЕАЛЬНОГО ВРЕМЕНИ ==========
        self._ws_connections: Dict[str, any] = {}
        self._ws_prices: Dict[str, float] = {}
        self._ws_callbacks: Dict[str, list] = {}

        # Для динамического списка тикеров
        self._top_tickers_cache: Optional[List[str]] = None
        self._top_tickers_cache_time: float = 0

        info("✅ TradingLoop инициализирован")

    async def start_websocket_for_ticker(self, ticker: str):
        """Запуск WebSocket для тикера"""
        if ticker in self._ws_connections:
            debug(f"📡 WebSocket для {ticker} уже запущен")
            return

        from trading_bot.api.tbank_client import tbank

        info(f"📡 Запуск WebSocket для {ticker}")

        task = asyncio.create_task(
            tbank.connect_websocket(ticker, self._on_websocket_price)
        )
        self._ws_connections[ticker] = task
        self._ws_prices[ticker] = None
        self._ws_callbacks[ticker] = []

        await asyncio.sleep(0.5)

    async def stop_websocket_for_ticker(self, ticker: str):
        """Остановка WebSocket для тикера"""
        if ticker in self._ws_connections:
            task = self._ws_connections[ticker]
            if not task.done():
                task.cancel()
                try:
                    await task
                except asyncio.CancelledError:
                    pass
            del self._ws_connections[ticker]
            info(f"🛑 WebSocket для {ticker} остановлен")

    async def _on_websocket_price(self, ticker: str, price: float, timestamp: datetime):
        """Обработка цены из WebSocket"""
        old_price = self._ws_prices.get(ticker)
        self._ws_prices[ticker] = price

        # Логируем только значительные изменения (>0.1%)
        if old_price and abs(price - old_price) / old_price > 0.001:
            debug(f"📡 WebSocket {ticker}: {old_price:.2f} → {price:.2f}")

            # Вызываем все зарегистрированные колбэки
            for callback in self._ws_callbacks.get(ticker, []):
                try:
                    await callback(ticker, price, timestamp)
                except Exception as e:
                    error(f"❌ Ошибка в callback для {ticker}: {e}")

    def register_websocket_callback(self, ticker: str, callback):
        """Регистрация callback для WebSocket"""
        if ticker not in self._ws_callbacks:
            self._ws_callbacks[ticker] = []
        self._ws_callbacks[ticker].append(callback)
        debug(f"📡 Зарегистрирован callback для {ticker}")

    async def _get_current_price_fast(self, ticker: str) -> float:
        """
        Быстрое получение цены (сначала из WebSocket, потом из кэша, потом из API)
        """
        from trading_bot.api.tbank_client import tbank

        # 1. Из WebSocket (самое быстрое)
        if hasattr(self, '_ws_prices') and ticker in self._ws_prices and self._ws_prices[ticker] is not None:
            return self._ws_prices[ticker]

        # 2. Из кэша
        figi = self.bot._get_figi_by_ticker(ticker)
        if figi and hasattr(self.bot, '_price_cache'):
            cached = self.bot._price_cache.get(figi)
            if cached is not None:
                return cached

        # 3. Из API (медленно, только если нет других вариантов)
        return self.bot._get_current_price(ticker)

    # ==================== НОВЫЕ МЕТОДЫ ДЛЯ БАЛАНСИРОВКИ ====================

    def get_market_exposure(self) -> Dict[str, float]:
        """
        Получение текущей рыночной экспозиции (LONG/SHORT баланс)
        """
        positions = _get_tbank().get_positions(force_refresh=True)

        long_value = 0.0
        short_value = 0.0

        for pos in positions:
            value = abs(pos.get('quantity', 0)) * pos.get('current_price', 0)
            if pos.get('quantity', 0) > 0:
                long_value += value
            elif pos.get('quantity', 0) < 0:
                short_value += value

        total_value = long_value + short_value

        if total_value == 0:
            return {
                'long_pct': 0.5,
                'short_pct': 0.5,
                'long_value': 0,
                'short_value': 0,
                'total_value': 0,
                'imbalance': 0,
                'status': 'neutral'
            }

        long_pct = long_value / total_value
        short_pct = short_value / total_value
        imbalance = abs(long_pct - 0.5) * 2

        if imbalance < 0.2:
            status = "🟢 ИДЕАЛЬНЫЙ БАЛАНС"
        elif imbalance < 0.4:
            status = "🟡 НОРМАЛЬНЫЙ ПЕРЕКОС"
        else:
            status = "🔴 СИЛЬНЫЙ ПЕРЕКОС"

        return {
            'long_pct': long_pct,
            'short_pct': short_pct,
            'long_value': long_value,
            'short_value': short_value,
            'total_value': total_value,
            'imbalance': imbalance,
            'status': status
        }

    def should_open_long(self, score: float) -> Tuple[bool, str]:
        """
        Проверка, можно ли открывать LONG с учётом баланса
        """
        exposure = self.get_market_exposure()

        # Если нет позиций - можно открывать любую
        if exposure['total_value'] == 0:
            return True, "нет позиций"

        # Если сильный перекос в LONG (>70%)
        if exposure['long_pct'] > 0.7:
            return False, f"слишком много LONG ({exposure['long_pct'] * 100:.0f}% > 70%)"

        # Если перекос в SHORT (<30%) - можно открывать LONG
        if exposure['long_pct'] < 0.3:
            return True, f"мало LONG ({exposure['long_pct'] * 100:.0f}% < 30%)"

        # Нормальный баланс - по сигналу
        return True, f"баланс OK ({exposure['long_pct'] * 100:.0f}% LONG)"

    def should_open_short(self, score: float) -> Tuple[bool, str]:
        """
        Проверка, можно ли открывать SHORT с учётом баланса
        """
        exposure = self.get_market_exposure()

        # Если нет позиций - можно открывать любую
        if exposure['total_value'] == 0:
            return True, "нет позиций"

        # Если сильный перекос в SHORT (>70%)
        if exposure['short_pct'] > 0.7:
            return False, f"слишком много SHORT ({exposure['short_pct'] * 100:.0f}% > 70%)"

        # Если перекос в LONG (<30%) - можно открывать SHORT
        if exposure['short_pct'] < 0.3:
            return True, f"мало SHORT ({exposure['short_pct'] * 100:.0f}% < 30%)"

        # Нормальный баланс - по сигналу
        return True, f"баланс OK ({exposure['short_pct'] * 100:.0f}% SHORT)"

    def get_max_positions_by_capital(self, total_capital: float) -> int:
        """
        Динамический лимит позиций в зависимости от капитала
        """
        if total_capital < 5000:
            return 2
        elif total_capital < 10000:
            return 3
        elif total_capital < 20000:
            return 4
        elif total_capital < 50000:
            return 6
        elif total_capital < 100000:
            return 10
        else:
            return 15

    def check_position_limits_advanced(self, side: str, total_cost: float, total_capital: float) -> Tuple[bool, str]:
        """
        РАСШИРЕННАЯ проверка лимитов (количество + баланс + загрузка)
        """
        # ========== ДИАГНОСТИКА ==========
        print(f"\n🔍🔍🔍 check_position_limits_advanced ВЫЗВАН!")
        print(f"   side = {side}")
        print(f"   total_cost = {total_cost:.2f}")
        print(f"   total_capital = {total_capital:.2f}")
        # =================================

        # 1. Получаем текущие позиции
        positions = _get_tbank().get_positions(force_refresh=True)

        print(f"   📊 positions = {len(positions)} позиций")
        for p in positions[:3]:
            print(f"      {p.get('ticker', '?')}: qty={p.get('quantity', 0)}, price={p.get('current_price', 0):.2f}")

        # 2. Проверка по количеству (новый динамический лимит)
        max_positions = self.get_max_positions_by_capital(total_capital)
        current_count = len(positions)
        print(f"   📊 current_count={current_count}, max_positions={max_positions}")

        if current_count >= max_positions:
            print(f"   ❌ ОТКАЗ: лимит {max_positions} позиций достигнут")
            return False, f"лимит {max_positions} позиций достигнут"

        # 3. Проверка баланса LONG/SHORT
        exposure = self.get_market_exposure()
        print(f"   ⚖️ exposure: LONG={exposure['long_pct'] * 100:.1f}%, SHORT={exposure['short_pct'] * 100:.1f}%")

        if side == "LONG":
            can_open, reason = self.should_open_long(0)
        else:
            can_open, reason = self.should_open_short(0)

        print(f"   📊 can_open={can_open}, reason='{reason}'")

        if not can_open:
            print(f"   ❌ ОТКАЗ: баланс - {reason}")
            return False, f"баланс: {reason}"

        # 4. Проверка загрузки капитала (максимум 85%)
        positions_value = sum(
            abs(p.get('quantity', 0)) * p.get('current_price', 0)
            for p in positions
        )
        current_used_pct = (positions_value / total_capital * 100) if total_capital > 0 else 0
        new_used_pct = ((positions_value + total_cost) / total_capital * 100) if total_capital > 0 else 0
        print(f"   📊 загрузка: {current_used_pct:.1f}% → {new_used_pct:.1f}%")

        MAX_TOTAL_PCT = 85
        if new_used_pct > MAX_TOTAL_PCT:
            print(f"   ❌ ОТКАЗ: загрузка {new_used_pct:.1f}% > {MAX_TOTAL_PCT}%")
            return False, f"загрузка {new_used_pct:.0f}% > {MAX_TOTAL_PCT}%"

        # 5. Проверка размера позиции (максимум 60% капитала)
        position_pct = (total_cost / total_capital * 100) if total_capital > 0 else 0
        MAX_POSITION_PCT = 60
        print(f"   📊 размер позиции: {position_pct:.1f}% от капитала")

        if position_pct > MAX_POSITION_PCT:
            print(f"   ❌ ОТКАЗ: позиция {position_pct:.1f}% > {MAX_POSITION_PCT}%")
            return False, f"позиция {position_pct:.0f}% > {MAX_POSITION_PCT}%"

        # Всё хорошо
        print(f"   ✅ ВСЕ ПРОВЕРКИ ПРОЙДЕНЫ!")
        info(
            f"   ✅ Лимиты: {current_count + 1}/{max_positions} поз, загрузка {current_used_pct:.0f}%→{new_used_pct:.0f}%, баланс {exposure['long_pct'] * 100:.0f}/{exposure['short_pct'] * 100:.0f}")

        return True, "OK"

    def _rebalance_positions_if_needed(self):
        """
        АВТОМАТИЧЕСКАЯ БАЛАНСИРОВКА при сильном перекосе
        """
        exposure = self.get_market_exposure()

        # Если перекос слишком сильный (>80/20)
        if exposure['imbalance'] > 0.6:  # > 80% в одну сторону
            warning(f"\n⚠️ КРИТИЧЕСКИЙ ПЕРЕКОС: LONG {exposure['long_pct'] * 100:.0f}% / SHORT {exposure['short_pct'] * 100:.0f}%")

            # Закрываем самую убыточную позицию в перекошенную сторону
            positions = _get_tbank().get_positions(force_refresh=True)

            if exposure['long_pct'] > 0.8:
                # Слишком много LONG - закрываем самую убыточную LONG
                long_positions = [p for p in positions if p.get('quantity', 0) > 0]
                if long_positions:
                    worst = min(long_positions, key=lambda x: x.get('current_profit', 0))
                    info(f"   🔄 Балансировка: закрываем убыточный LONG {worst.get('ticker', '?')}")
                    position_closer.close_position_smart(worst.get('figi'))

            elif exposure['short_pct'] > 0.8:
                # Слишком много SHORT - закрываем самую убыточную SHORT
                short_positions = [p for p in positions if p.get('quantity', 0) < 0]
                if short_positions:
                    worst = min(short_positions, key=lambda x: x.get('current_profit', 0))
                    info(f"   🔄 Балансировка: закрываем убыточный SHORT {worst.get('ticker', '?')}")
                    position_closer.close_position_smart(worst.get('figi'))

    # ==================== ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ ДЛЯ ВРЕМЕНИ ====================

    def _get_max_overnight_exposure(self, total_capital: float, total_pnl: float) -> float:
        """
        Расчёт максимальной суммы позиций для переноса через выходные
        Чем больше прибыль, тем больше можно держать
        """
        base_limit = 5000  # Базовый лимит

        # Если портфель в убытке - лимит минимальный
        if total_pnl <= 0:
            return base_limit

        # Прибыль портфеля в процентах
        profit_pct = (total_pnl / total_capital) * 100 if total_capital > 0 else 0

        # Динамическое увеличение лимита в зависимости от прибыли
        if profit_pct >= 10:
            return float('inf')  # Прибыль >10% - можно держать всё
        elif profit_pct >= 5:
            return base_limit * 4  # 20000
        elif profit_pct >= 2:
            return base_limit * 2  # 10000

        return base_limit

    def _get_minutes_to_close(self, now) -> int:
        """Получение минут до закрытия текущей сессии"""
        current_time = now.time()
        weekday = now.weekday()

        # Пятница - вечерняя сессия заканчивается в 23:49
        if weekday == 4:  # Пятница
            close_time = dt_time(23, 49)  # ← ИСПРАВЛЕНО: было 18,59
            if current_time < close_time:
                minutes = (close_time.hour * 60 + close_time.minute) - (current_time.hour * 60 + current_time.minute)
                return minutes

        # Будни - вечерняя сессия до 23:49 (ПН-ЧТ)
        if 0 <= weekday <= 3:  # ПН-ЧТ
            close_time = dt_time(23, 49)
            if current_time < close_time:
                minutes = (close_time.hour * 60 + close_time.minute) - (current_time.hour * 60 + current_time.minute)
                return minutes

        # ДСВД/OTC сессия в выходные до 19:00
        from trading_bot.utils.time_utils import is_weekend_trading_time, is_otc_trading_time
        if is_weekend_trading_time() or is_otc_trading_time():
            close_time = dt_time(19, 0)
            if current_time < close_time:
                minutes = (close_time.hour * 60 + close_time.minute) - (current_time.hour * 60 + current_time.minute)
                return minutes

        return 999  # Далеко до закрытия

    def _close_weekend_positions(self, positions):
        """
        ИНТЕЛЛЕКТУАЛЬНОЕ закрытие позиций перед выходными - РАСШИРЕННАЯ ВЕРСИЯ
        Учитывает:
        - Локальный тренд каждой акции
        - Рыночные условия (общий тренд, волатильность)
        - Новостной фон
        - Технические уровни (поддержка/сопротивление, RSI)
        - Динамический лимит на перенос (зависит от прибыли портфеля)
        - Маржинальные издержки
        - Размер позиции относительно капитала
        - Время удержания позиции
        - Историческую волатильность инструмента
        - Ликвидность инструмента в выходные
        """
        now = get_moscow_time()
        minutes_left = self._get_minutes_to_close(now)

        info(
            f"⏰ [WEEKEND_CHECK] Время: {now.strftime('%H:%M:%S')}, минут до закрытия: {minutes_left}, позиций: {len(positions)}")

        # ========== ПРИНУДИТЕЛЬНОЕ ЗАКРЫТИЕ В ПЯТНИЦУ ПОСЛЕ 23:40 ==========
        if now.weekday() == 4 and now.time() >= dt_time(23, 40):
            warning(f"\n{'🔒' * 40}")
            warning("🔒 ПЯТНИЦА 23:40+ - ПРИНУДИТЕЛЬНОЕ ЗАКРЫТИЕ ВСЕХ ПОЗИЦИЙ!")
            warning(f"{'🔒' * 40}")

            closed_count = 0
            for pos in positions:
                if not isinstance(pos, dict):
                    continue
                figi = pos.get('figi')
                if not figi:
                    continue
                qty = pos.get('quantity', 0)
                if qty == 0:
                    continue

                from trading_bot.api.tbank_client import tbank
                ticker = tbank._get_ticker_by_figi(figi) or figi[:12]
                side = "LONG" if qty > 0 else "SHORT"

                warning(f"   🔒 Принудительно закрываем {ticker} ({side})")
                try:
                    if qty > 0:
                        success_flag = _get_tbank().sell(figi, abs(qty), use_market=True)
                    else:
                        success_flag = _get_tbank().buy(figi, abs(qty), use_market=True)

                    if success_flag:
                        closed_count += 1
                        success(f"   ✅ {ticker} закрыт")
                    else:
                        error(f"   ❌ Не удалось закрыть {ticker}")
                except Exception as e:
                    error(f"   ❌ Ошибка при закрытии {ticker}: {e}")

            info(f"\n📊 ПРИНУДИТЕЛЬНО ЗАКРЫТО: {closed_count} позиций")
            return True

        # ========== ОБЫЧНОЕ ЗАКРЫТИЕ (ЗА 5 МИНУТ ДО КОНЦА СЕССИИ) ==========
        if minutes_left <= 5 and minutes_left > 0:
            warning(f"\n{'🔒' * 40}")
            warning(f"🔒 ДО ЗАКРЫТИЯ СЕССИИ {minutes_left} МИН")
            warning(f"🔒 ПРИНИМАЕМ РЕШЕНИЕ ПО {len(positions)} ПОЗИЦИЯМ")
            warning(f"{'🔒' * 40}")

            # ========== 1. ПОЛУЧАЕМ РЫНОЧНЫЕ УСЛОВИЯ ==========
            market_conditions = self._get_market_conditions_for_weekend()
            info(f"\n📊 РЫНОЧНЫЕ УСЛОВИЯ:")
            info(f"   📈 Общий тренд: {market_conditions['trend']} (сила {market_conditions['trend_strength']:.2f})")
            info(f"   📊 Волатильность: {market_conditions['volatility']:.1%}")
            info(f"   📰 Новостной фон: {market_conditions['news_risk']}")

            # ========== 2. РАСЧЁТ ОБЩИХ ПОКАЗАТЕЛЕЙ ПОРТФЕЛЯ ==========
            total_portfolio_pnl = 0.0
            total_position_value = 0.0
            positions_data = []

            for pos in positions:
                if not isinstance(pos, dict):
                    continue

                figi = pos.get('figi')
                if not figi:
                    continue

                qty = pos.get('quantity', 0)
                avg_price = pos.get('avg_price', 0)
                current_price = _get_tbank().get_current_price(figi)

                if not current_price or qty == 0:
                    continue

                position_value = abs(qty) * current_price
                total_position_value += position_value

                # Расчёт P&L
                if qty > 0:  # LONG
                    pnl = (current_price - avg_price) * qty
                    profit_pct = (current_price - avg_price) / avg_price * 100
                    side = "LONG"
                else:  # SHORT
                    pnl = (avg_price - current_price) * abs(qty)
                    profit_pct = (avg_price - current_price) / avg_price * 100
                    side = "SHORT"

                total_portfolio_pnl += pnl
                from trading_bot.api.tbank_client import tbank
                positions_data.append({
                    'figi': figi,
                    'ticker': tbank._get_ticker_by_figi(figi) or figi[:12],
                    'side': side,
                    'qty': abs(qty),
                    'avg_price': avg_price,
                    'current_price': current_price,
                    'position_value': position_value,
                    'pnl': pnl,
                    'profit_pct': profit_pct
                })

            # Сортируем позиции: сначала убыточные, потом прибыльные
            positions_data.sort(key=lambda x: x['profit_pct'])

            total_capital = getattr(self.bot, 'total_capital', 0)
            max_overnight = self._get_max_overnight_exposure(total_capital, total_portfolio_pnl)

            # ========== 3. ЛОГИРУЕМ СОСТОЯНИЕ ПОРТФЕЛЯ ==========
            profit_emoji = "🟢" if total_portfolio_pnl > 0 else "🔴" if total_portfolio_pnl < 0 else "⚪"
            info(f"\n💰 СОСТОЯНИЕ ПОРТФЕЛЯ:")
            info(f"   📊 Капитал: {total_capital:.0f}₽")
            info(
                f"   {profit_emoji} P&L: {total_portfolio_pnl:+.0f}₽ ({total_portfolio_pnl / total_capital * 100:+.1f}%)")
            info(
                f"   📈 Экспозиция: {total_position_value:.0f}₽ ({total_position_value / total_capital * 100:.0f}% от капитала)")

            if max_overnight == float('inf'):
                info(f"   🟢 ЛИМИТ ПЕРЕНОСА: НЕ ОГРАНИЧЕН (прибыль портфеля >10%)")
            else:
                info(f"   🟡 ЛИМИТ ПЕРЕНОСА: {max_overnight:.0f}₽")
                info(f"   ⚠️  Позиции крупнее {max_overnight:.0f}₽ будут закрыты")

            # ========== 4. АНАЛИЗ КАЖДОЙ ПОЗИЦИИ ==========
            info(f"\n🔍 АНАЛИЗ {len(positions_data)} ПОЗИЦИЙ:")
            info(f"{'=' * 70}")

            closed_count = 0
            kept_count = 0
            closed_value = 0
            kept_value = 0

            for pos_data in positions_data:
                ticker = pos_data['ticker']
                side = pos_data['side']
                qty = pos_data['qty']
                profit_pct = pos_data['profit_pct']
                pnl = pos_data['pnl']
                position_value = pos_data['position_value']
                current_price = pos_data['current_price']
                avg_price = pos_data['avg_price']
                figi = pos_data['figi']

                # Пропуск для уже закрытых
                if qty == 0:
                    continue

                pnl_emoji = "🟢" if pnl > 0 else "🔴" if pnl < 0 else "⚪"
                info(
                    f"\n📌 {ticker} | {side} | {qty}шт | {avg_price:.2f}→{current_price:.2f} | {pnl_emoji} {pnl:+.0f}₽ ({profit_pct:+.1f}%) | Позиция: {position_value:.0f}₽")
                info(f"   {'-' * 66}")

                # ========== ИНТЕЛЛЕКТУАЛЬНЫЙ АНАЛИЗ ==========
                should_close, reason, confidence, details = self._should_close_position_smart_detailed(
                    ticker=ticker,
                    figi=figi,
                    side=side,
                    qty=qty,
                    profit_pct=profit_pct,
                    pnl=pnl,
                    position_value=position_value,
                    current_price=current_price,
                    avg_price=avg_price,
                    market_conditions=market_conditions,
                    total_portfolio_pnl=total_portfolio_pnl,
                    max_overnight=max_overnight,
                    total_capital=total_capital
                )

                # Логируем детали решения
                info(f"   📊 Анализ:")
                for detail in details:
                    info(f"      {detail}")
                info(f"   🧠 Решение: {'🔒 ЗАКРЫТЬ' if should_close else '⏸️ ОСТАВИТЬ'}")
                info(f"   📊 Уверенность: {confidence:.0%}")
                info(f"   💬 Причина: {reason}")

                if should_close:
                    warning(f"   🔒 ЗАКРЫВАЕМ {ticker}...")

                    try:
                        if side == "LONG":
                            success_flag = _get_tbank().sell(figi, qty, use_market=True)
                        else:
                            success_flag = _get_tbank().buy(figi, qty, use_market=True)

                        if success_flag:
                            closed_count += 1
                            closed_value += position_value
                            success(f"   ✅ {ticker} закрыт")
                        else:
                            error(f"   ❌ Не удалось закрыть {ticker}")
                    except Exception as e:
                        error(f"   ❌ Ошибка при закрытии {ticker}: {e}")
                else:
                    info(f"   ⏸️ {ticker}: ОСТАВЛЯЕМ на выходные")
                    kept_count += 1
                    kept_value += position_value

            # ========== 5. ИТОГОВАЯ СТАТИСТИКА ==========
            info(f"\n{'=' * 70}")
            info(f"📊 ИТОГИ ЗАКРЫТИЯ:")
            info(f"   🔒 Закрыто: {closed_count} позиций на сумму {closed_value:.0f}₽")
            info(f"   ⏸️ Оставлено: {kept_count} позиций на сумму {kept_value:.0f}₽")
            info(f"   💰 Свободно средств станет: ~{_get_tbank().get_available_funds()[0] + closed_value:.0f}₽")
            info(f"{'=' * 70}")

            return True

        return False

    def _get_market_conditions_for_weekend(self) -> Dict[str, Any]:
        """Получение рыночных условий для принятия решения перед выходными"""
        try:
            from trading_bot.analysis.market_analyzer import market_analyzer
            from trading_bot.analysis.news_sentiment import news_sentiment

            # Анализ рынка в целом
            market = market_analyzer.analyze_market_conditions()

            # Глобальный новостной фон
            news_risk = "neutral"
            try:
                # Оценка новостей за последние 24 часа
                news_score = news_sentiment.get_global_sentiment(days=1)
                if news_score < -0.3:
                    news_risk = "negative"  # Риск падения
                elif news_score > 0.3:
                    news_risk = "positive"  # Риск роста
            except:
                pass

            # Определяем общий тренд
            if market.trend > 0.3:
                trend = "bullish"
            elif market.trend < -0.3:
                trend = "bearish"
            else:
                trend = "sideways"

            # Волатильность
            volatility = min(market.volatility, 1.0)

            return {
                'trend': trend,
                'trend_strength': abs(market.trend),
                'volatility': volatility,
                'news_risk': news_risk,
                'market_score': market.trend
            }
        except Exception as e:
            debug(f"Не удалось получить рыночные условия: {e}")
            return {
                'trend': 'sideways',
                'trend_strength': 0,
                'volatility': 0.3,
                'news_risk': 'neutral',
                'market_score': 0
            }

    def _analyze_position_technicals(self, ticker: str, figi: str, side: str,
                                     current_price: float, avg_price: float) -> Dict[str, Any]:
        """Технический анализ конкретной позиции с определением ЛОКАЛЬНОГО тренда и ATR"""
        try:
            # ✅ ИСПОЛЬЗУЕМ side и avg_price (убираем тёмно-серый цвет)
            side_upper = side.upper() if side else "UNKNOWN"
            distance_from_entry_pct = ((current_price - avg_price) / avg_price * 100) if avg_price > 0 else 0

            candles = _get_tbank().get_candles(figi, days=2, interval_minutes=15)

            if candles and len(candles) > 50:
                candles = candles[-50:]

            if not candles or len(candles) < 20:
                return {
                    'near_resistance': False, 'near_support': False,
                    'overbought': False, 'oversold': False,
                    'trend_weakening': False, 'volume_drop': False,
                    'local_trend': 'neutral', 'trend_strength': 0,
                    'atr_pct': 1.5,
                    'side': side_upper,  # ✅ ДОБАВЛЕНО
                    'distance_from_entry_pct': distance_from_entry_pct  # ✅ ДОБАВЛЕНО
                }

            closes = []
            highs = []
            lows = []
            volumes = []

            for c in candles:
                if isinstance(c, (list, tuple)) and len(c) >= 2:
                    close_val = c[0]
                    volume_val = c[1] if len(c) > 1 else 0
                    closes.append(close_val)
                    volumes.append(volume_val)
                    highs.append(close_val * 1.005)
                    lows.append(close_val * 0.995)
                elif hasattr(c, 'close'):
                    closes.append(c.close)
                    volumes.append(getattr(c, 'volume', 0))
                    highs.append(getattr(c, 'high', c.close))
                    lows.append(getattr(c, 'low', c.close))
                elif isinstance(c, dict):
                    closes.append(c.get('close', 0))
                    volumes.append(c.get('volume', 0))
                    highs.append(c.get('high', closes[-1] if closes else 0))
                    lows.append(c.get('low', closes[-1] if closes else 0))
                else:
                    closes.append(c)
                    volumes.append(0)
                    highs.append(c)
                    lows.append(c)

                if len(closes) < 20:
                    return {
                        'near_resistance': False, 'near_support': False,
                        'overbought': False, 'oversold': False,
                        'trend_weakening': False, 'volume_drop': False,
                        'local_trend': 'neutral', 'trend_strength': 0,
                        'atr_pct': 1.5,
                        'side': side_upper,  # ✅ ДОБАВЛЕНО
                        'distance_from_entry_pct': distance_from_entry_pct  # ✅ ДОБАВЛЕНО
                    }

                # ========== РАСЧЁТ ATR ==========
                true_ranges = []
                for i in range(1, len(closes)):
                    high_low = highs[i] - lows[i]
                    high_close = abs(highs[i] - closes[i - 1])
                    low_close = abs(lows[i] - closes[i - 1])
                    true_range = max(high_low, high_close, low_close)
                    true_ranges.append(true_range)

                atr = sum(true_ranges[-14:]) / min(14, len(true_ranges)) if true_ranges else 0
                atr_pct = (atr / current_price) * 100 if current_price > 0 else 1.5

                # ========== ОПРЕДЕЛЕНИЕ ЛОКАЛЬНОГО ТРЕНДА ==========
                ma20 = sum(closes[-20:]) / 20 if len(closes) >= 20 else closes[-1]
                ma10 = sum(closes[-10:]) / 10 if len(closes) >= 10 else closes[-1]
                ma5 = sum(closes[-5:]) / 5 if len(closes) >= 5 else closes[-1]

                current = closes[-1]

                if current > ma20 and ma20 > ma10 and ma10 > ma5:
                    local_trend = "bullish"
                    trend_strength = min(1.0, (current - ma20) / ma20 * 10)
                elif current < ma20 and ma20 < ma10 and ma10 < ma5:
                    local_trend = "bearish"
                    trend_strength = min(1.0, (ma20 - current) / ma20 * 10)
                else:
                    local_trend = "neutral"
                    trend_strength = 0

                # Определяем уровни
                resistance = max(highs[-20:])
                support = min(lows[-20:])

                near_resistance = abs(current_price - resistance) / current_price < 0.015
                near_support = abs(current_price - support) / current_price < 0.015

                # RSI
                rsi = self._calculate_rsi(closes)
                overbought = rsi > 70
                oversold = rsi < 30

                # Тренд ослабевает?
                recent_trend = (closes[-1] - closes[-10]) / closes[-10] if len(closes) >= 10 else 0
                older_trend = (closes[-10] - closes[-20]) / closes[-20] if len(closes) >= 20 else 0
                trend_weakening = abs(recent_trend) < abs(older_trend) * 0.5 if older_trend != 0 else False

                # Объёмы падают?
                if len(volumes) >= 20:
                    recent_volume_avg = sum(volumes[-5:]) / 5 if len(volumes) >= 5 else 0
                    older_volume_avg = sum(volumes[-20:-5]) / 15 if len(volumes) >= 20 else recent_volume_avg
                    volume_drop = recent_volume_avg < older_volume_avg * 0.7 if older_volume_avg > 0 else False
                else:
                    volume_drop = False

                # ✅ ВОЗВРАЩАЕМ С ДОБАВЛЕННЫМИ ПОЛЯМИ
                return {
                    'near_resistance': near_resistance,
                    'near_support': near_support,
                    'overbought': overbought,
                    'oversold': oversold,
                    'trend_weakening': trend_weakening,
                    'volume_drop': volume_drop,
                    'rsi': rsi,
                    'local_trend': local_trend,
                    'trend_strength': trend_strength,
                    'atr': atr,
                    'atr_pct': atr_pct,
                    'ma20': ma20,
                    'ma10': ma10,
                    'side': side_upper,  # ✅ ДОБАВЛЕНО
                    'distance_from_entry_pct': distance_from_entry_pct  # ✅ ДОБАВЛЕНО
                }

        except Exception as e:
            debug(f"Ошибка тех.анализа {ticker}: {e}")
            return {
                'near_resistance': False, 'near_support': False,
                'overbought': False, 'oversold': False,
                'trend_weakening': False, 'volume_drop': False,
                'local_trend': 'neutral', 'trend_strength': 0,
                'atr_pct': 1.5,
                'side': side.upper() if side else "UNKNOWN",  # ✅ ДОБАВЛЕНО
                'distance_from_entry_pct': ((current_price - avg_price) / avg_price * 100) if avg_price > 0 else 0
                # ✅ ДОБАВЛЕНО
            }

    def _calculate_rsi(self, closes: List[float], period: int = 14) -> float:
        """Расчёт RSI"""
        if len(closes) < period + 1:
            return 50

        gains = []
        losses = []

        for i in range(1, len(closes)):
            change = closes[i] - closes[i - 1]
            if change > 0:
                gains.append(change)
                losses.append(0)
            else:
                gains.append(0)
                losses.append(abs(change))

        avg_gain = sum(gains[-period:]) / period
        avg_loss = sum(losses[-period:]) / period

        if avg_loss == 0:
            return 100

        rs = avg_gain / avg_loss
        rsi = 100 - (100 / (1 + rs))

        return rsi

    def _get_position_hold_time(self, figi: str) -> Optional[float]:
        """Получить время удержания позиции в секундах"""
        try:
            from trading_bot.risk.position_manager import position_manager
            pos = position_manager.get_position(figi)
            if pos and hasattr(pos, 'open_time'):
                return (get_moscow_time() - pos.open_time).total_seconds()
        except:
            pass
        return None

    # ==================== ОСТАЛЬНЫЕ МЕТОДЫ ====================

    def _is_api_available(self) -> bool:
        """Проверка доступности API Т-Банка (с учётом OTC и ДСВД)"""
        try:
            from trading_bot.api.tbank_client import tbank
            import threading

            result = [None]
            error = [None]

            def _check():
                try:
                    result[0] = tbank.get_available_funds()
                except Exception as e:
                    error[0] = e

            thread = threading.Thread(target=_check, daemon=True)
            thread.start()
            thread.join(timeout=3.0)

            from trading_bot.utils.time_utils import is_weekend_trading_time, is_otc_trading_time
            can_trade_weekend = is_weekend_trading_time() or is_otc_trading_time()

            info(f"🔍 Проверка API: can_trade_weekend={can_trade_weekend}")

            if thread.is_alive():
                debug("⏰ API проверка превысила таймаут 3с")
                if can_trade_weekend:
                    info("   📊 ДСВД/OTC активны, считаем API доступным")
                    return True
                return False

            if error[0]:
                debug(f"⚠️ API недоступен: {error[0]}")
                if can_trade_weekend:
                    info("   📊 ДСВД/OTC активны, считаем API доступным")
                    return True
                return False

            if result[0] and result[0][1] > 0:
                info(f"   ✅ API работает, капитал: {result[0][1]:.2f}₽")
                return True

            if can_trade_weekend:
                info("   📊 ДСВД/OTC активны (капитал=0), считаем API доступным")
                return True

            return False

        except Exception as e:
            debug(f"Ошибка проверки API: {e}")
            try:
                from trading_bot.utils.time_utils import is_weekend_trading_time, is_otc_trading_time
                return is_weekend_trading_time() or is_otc_trading_time()
            except:
                return False

    def start_loop(self):
        """Запуск торгового цикла"""
        if self._running:
            warning("⚠️ TradingLoop уже запущен")
            return
    
        from trading_bot.utils.time_utils import get_moscow_time, is_weekend_trading_time, is_otc_trading_time
    
        now = get_moscow_time()
        is_weekend = now.weekday() >= 5
        can_trade_weekend = is_weekend_trading_time() or is_otc_trading_time()
        
        # Синхронизация позиций при старте
        self._sync_positions()
        
    
        if is_weekend and not can_trade_weekend:
            warning("🌙 ВЫХОДНОЙ ДЕНЬ - ТОРГОВЛЯ НЕВОЗМОЖНА")
            warning("   Pre-market торговля отключена")
            warning("   Бот переходит в режим ожидания до понедельника")
    
            self._running = True
            self._thread = threading.Thread(target=self._weekend_wait_loop, daemon=True, name="WeekendWaitLoop")
            self._thread.start()
            return
    
        info("🔄 Запуск TradingLoop...")
        self._running = True
        self._thread = threading.Thread(target=self._run_async_wrapper, daemon=True, name="TradingLoop")
        self._thread.start()
        success("✅ Торговый цикл запущен")

    def _run_async_wrapper(self):
        """Обёртка для запуска асинхронного _run в потоке"""
        import asyncio
        asyncio.run(self._run())

    def _weekend_wait_loop(self):
        """Цикл ожидания в выходные дни"""
        from trading_bot.utils.time_utils import get_moscow_time, is_weekend_trading_time, is_otc_trading_time

        info("🌙 Режим ожидания выходного дня активирован")

        while self._running:
            now = get_moscow_time()
            is_weekend = now.weekday() >= 5

            can_trade_weekend = is_weekend_trading_time() or is_otc_trading_time()

            if not is_weekend or can_trade_weekend:
                info("🏛️ Торговля возобновляется! Запускаем основной цикл...")
                self._running = False
                time.sleep(2)
                self.start()
                return

            time.sleep(300)

        info("🛑 Режим ожидания выходного дня остановлен")

    def stop_loop(self):
        """Остановка торгового цикла"""
        info("🛑 Остановка TradingLoop...")
        self._running = False
        if self._thread:
            self._thread.join(timeout=5)
        success("🛑 Торговый цикл остановлен")

    # ==================== ОСНОВНОЙ ЦИКЛ ====================

    async def _run(self):
        """Основной цикл - с красивым логированием и полной обработкой ошибок"""
        from trading_bot.utils.time_utils import get_moscow_time

        info("🔄 TradingLoop _run() МЕТОД ЗАПУЩЕН")
        info(f"   self._running = {self._running}")

        if not self._is_api_available():
            warning("⚠️ API Т-Банка НЕДОСТУПЕН при старте!")
            warning("   Возможные причины:")
            warning("   1. Выходной день (суббота/воскресенье)")
            warning("   2. Технические работы у брокера")
            warning("   3. Проблемы с сетью")
            warning("   Переходим в режим ожидания...")

            while self._running and not self._is_api_available():
                time.sleep(300)
                now = get_moscow_time()
                if now.weekday() < 5 and now.hour >= 10:
                    info("🔄 Повторная проверка API...")

            if not self._running:
                return
            info("✅ API Т-Банка ДОСТУПЕН! Запускаем торговлю...")

        now = get_moscow_time()
        is_weekend = now.weekday() >= 5

        from trading_bot.utils.time_utils import is_weekend_trading_time, is_otc_trading_time
        can_trade_weekend = is_weekend_trading_time() or is_otc_trading_time()

        if is_weekend and not can_trade_weekend:
            info("🌙 ВЫХОДНОЙ ДЕНЬ - ТОРГОВЛЯ НЕВОЗМОЖНА")
            info("   Бот переходит в режим ожидания (проверка раз в 5 минут)")
            weekend_mode = True
            cycle_sleep = 300
        else:
            weekend_mode = False
            cycle_sleep = 5
            if is_weekend:
                info("🌞 ВЫХОДНОЙ ДЕНЬ - ТОРГОВЛЯ ВОЗМОЖНА (ДСВД/OTC активны)")
            else:
                info("🏛️ БУДНИЙ ДЕНЬ - обычный режим работы")

        self._sync_positions()

        from trading_bot.core.settings_manager import settings_manager, SettingsSubscriber

        if not hasattr(self, '_settings_subscribed'):
            self._settings_subscribed = True
            SettingsSubscriber.subscribe('fundamental_enabled', self._on_setting_changed)
            SettingsSubscriber.subscribe('technical_enabled', self._on_setting_changed)
            SettingsSubscriber.subscribe('news_enabled', self._on_setting_changed)
            SettingsSubscriber.subscribe('use_swing', self._on_setting_changed)
            SettingsSubscriber.subscribe('use_scalping', self._on_setting_changed)
            SettingsSubscriber.subscribe('use_position', self._on_setting_changed)
            SettingsSubscriber.subscribe('use_fundamental_in_trading', self._on_setting_changed)
            SettingsSubscriber.subscribe('use_margin', self._on_setting_changed)
            info("✅ TradingLoop подписан на изменения настроек")

        self._active_settings = self._load_settings()
        info(f"⚙️ НАСТРОЙКИ ЗАГРУЖЕНЫ:")
        info(f"   📊 Фундаментальный анализ: {self._active_settings['fundamental_enabled']}")
        info(f"   📈 Технический анализ: {self._active_settings['technical_enabled']}")
        info(f"   📰 Новостной анализ: {self._active_settings['news_enabled']}")
        info(f"   ⚡ Скальпинг: {self._active_settings['use_scalping']}")
        info(f"   🔄 Свинг: {self._active_settings['use_swing']}")
        info(f"   📦 Позиционный: {self._active_settings['use_position']}")
        info(f"   💳 Маржа: {self._active_settings['use_margin']}")

        try:
            from trading_bot.analysis.fundamental_analyzer import fundamental_analyzer
            from trading_bot.analysis.news_sentiment import news_sentiment
            from trading_bot.analysis.technical_analyzer import analyzer

            info(f"📊 Статус анализаторов:")
            info(f"   📈 Технический: enabled={analyzer.enabled}")
            info(f"   📊 Фундаментальный: enabled={fundamental_analyzer.enabled}")
            info(f"   📰 Новостной: enabled={news_sentiment.enabled}")
            if hasattr(news_sentiment, 'get_stats'):
                stats = news_sentiment.get_stats()
                info(f"   📰 News stats: {stats}")

            fundamental_analyzer.enabled = self._active_settings['fundamental_enabled']
            news_sentiment.enabled = self._active_settings['news_enabled']
            analyzer.enabled = self._active_settings['technical_enabled']
            info("✅ Настройки применены к анализаторам")
        except Exception as e:
            warning(f"⚠️ Ошибка применения настроек к анализаторам: {e}")

        info("🚀 ЗАПУСК ПЕРВОГО ТОРГОВОГО ЦИКЛА...")

        while self._running:
            try:
                cycle_start = time.time()

                now = get_moscow_time()
                is_weekend = now.weekday() >= 5

                from trading_bot.utils.time_utils import is_weekend_trading_time, is_otc_trading_time
                can_trade_weekend = is_weekend_trading_time() or is_otc_trading_time()

                if is_weekend and not can_trade_weekend and not weekend_mode:
                    weekend_mode = True
                    cycle_sleep = 300
                    info("🌙 ВЫХОДНОЙ ДЕНЬ - ТОРГОВЛЯ НЕВОЗМОЖНА, режим ожидания")
                    self._weekend_notified = False
                elif (not is_weekend or can_trade_weekend) and weekend_mode:
                    weekend_mode = False
                    cycle_sleep = 5
                    info("🏛️ Торговля возобновляется, выходим из режима ожидания")
                    self._sync_positions()

                if weekend_mode:
                    if not hasattr(self, '_weekend_notified'):
                        info("🌙 ВЫХОДНОЙ ДЕНЬ - API Т-Банка недоступен")
                        info("   Торговля возобновится в понедельник утром")
                        self._weekend_notified = True
                    time.sleep(cycle_sleep)
                    continue

                self._cycle_count += 1
                self.bot._cycle_count = self._cycle_count

                info(f"🔄 ЦИКЛ #{self._cycle_count} | {get_moscow_time().strftime('%H:%M:%S')}")
                info(f"   {'=' * 50}")

                # ========== 0. ЗАКРЫТИЕ ПОЗИЦИЙ (вне зависимости от торгов) ==========
                # ✅ force_refresh=True для реальных позиций
                positions = self.bot._get_positions(force_refresh=True)
                self._close_positions_if_needed(positions)

                # ========== 1. ПРОВЕРКА ВРЕМЕНИ ТОРГОВ ==========
                info("📡 [1/11] ПРОВЕРКА ВРЕМЕНИ ТОРГОВ...")
                trading_allowed = self._is_trading_time()
                info(f"   ⏰ Торговля разрешена: {trading_allowed}")

                if not trading_allowed:
                    info(f"   ⏸️ Торговое время выключено, ждём 60 секунд")
                    time.sleep(60)
                    continue

                # ========== 2. ПОЛУЧЕНИЕ КАПИТАЛА ==========
                info("💰 [2/11] ПОЛУЧЕНИЕ КАПИТАЛА...")
                try:
                    available: float
                    total_capital: float
                    available, total_capital, _ = _get_tbank().get_available_funds()
                    info(f"   💰 КАПИТАЛ: {total_capital:.0f}₽ | СВОБОДНО: {available:.0f}₽")

                    if total_capital > 0:
                        self._adaptive_configuration(total_capital)

                    from trading_bot.config import config
                    if hasattr(config, 'total_capital') and config.total_capital != total_capital:
                        config.total_capital = total_capital
                        debug(f"   💰 Авто-обновление капитала в config: {total_capital:.2f}₽")

                    if total_capital == 0 and available == 0:
                        warning("   ⚠️ КАПИТАЛ = 0₽! Проверьте подключение к T-Bank API и токен!")

                        try:
                            positions = self.bot._get_positions(force_refresh=True)
                            info(f"   📊 Позиций у брокера: {len(positions)}")
                        except Exception as e2:
                            warning(f"   ❌ Ошибка получения позиций: {e2}")

                except Exception as e:
                    error(f"   ❌ Ошибка получения капитала: {e}")
                    self._consecutive_errors += 1
                    time.sleep(10)
                    continue

                # ========== 3. АВТОМАТИЧЕСКАЯ НАСТРОЙКА SHORT ==========
                info("🔻 [3/11] НАСТРОЙКА SHORT...")
                if total_capital > 0:
                    from trading_bot.config import config
                    short_enabled, short_reason = config.update_short_settings(total_capital)

                    if short_enabled != self._last_short_status:
                        if short_enabled:
                            info(f"   🔻 SHORT АКТИВИРОВАН: {short_reason}")
                        else:
                            warning(f"   🔻 SHORT ДЕАКТИВИРОВАН: {short_reason}")
                        self._last_short_status = short_enabled

                    if self._cycle_count - self._last_market_log_cycle >= 10:
                        try:
                            from trading_bot.analysis.market_analyzer import market_analyzer
                            market_conditions = market_analyzer.analyze_market_conditions()
                            config.update_market_conditions(
                                volatility=market_conditions.volatility,
                                trend=market_conditions.trend
                            )
                            vol_icon = "📈" if market_conditions.trend > 0 else "📉" if market_conditions.trend < 0 else "➡️"
                            info(f"   {vol_icon} РЫНОК: волатильность={market_conditions.volatility * 100:.1f}%, "
                                 f"тренд={market_conditions.trend:.2f} | {market_conditions.trend_direction}")
                            self._last_market_log_cycle = self._cycle_count
                        except Exception as e:
                            debug(f"   Не удалось получить рыночные условия: {e}")

                # ========== 4. ПОЛУЧЕНИЕ ПОЗИЦИЙ ==========
                info("📈 [4/11] ПОЛУЧЕНИЕ ПОЗИЦИЙ...")
                # ✅ force_refresh=True для реальных позиций
                positions = self.bot._get_positions(force_refresh=True)
                current_positions = len(positions)
                info(f"   📊 ПОЗИЦИЙ: {current_positions}")

                if current_positions > 0:
                    for pos in positions:
                        if not isinstance(pos, dict):
                            debug(f"   ⚠️ Пропуск позиции: ожидался dict, получен {type(pos)}")
                            continue
                        figi = pos.get('figi', 'unknown')
                        from trading_bot.api.tbank_client import tbank
                        ticker = tbank._get_ticker_by_figi(figi) or figi[:12]
                        qty = pos.get('quantity', 0)
                        avg = pos.get('avg_price', 0)
                        side = "SHORT" if qty < 0 else "LONG"
                        cur = _get_tbank().get_current_price(figi)

                        if cur:
                            if qty < 0:
                                pnl = (avg - cur) * abs(qty)
                            else:
                                pnl = (cur - avg) * qty
                            icon = "🟢" if pnl > 0 else "🔴" if pnl < 0 else "⚪"
                            pnl_color = "+" if pnl > 0 else ""
                            info(
                                f"      {icon} {side} {ticker}: {abs(qty)}шт | {avg:.2f}→{cur:.2f} | {pnl_color}{pnl:+.2f}₽")
                else:
                    info(f"   📭 Нет открытых позиций")

                # ========== 4.5 ПРОВЕРКА TP/SL (ПЕРЕД МАРЖЕЙ!) ==========
                info("⚡ [4.6/11] БЫСТРОЕ СКАНИРОВАНИЕ...")

                top_tickers = self._get_top_liquid_tickers(limit=10)

                quick_candidates = []
                for ticker in top_tickers:
                    try:
                        figi = self.bot._get_figi_by_ticker(ticker)
                        if not figi:
                            continue

                        current_price = _get_tbank().get_current_price(figi)
                        if not current_price:
                            continue

                        candidate = await self.bot.stock_scanner.quick_analyze_from_websocket(ticker, current_price)
                        if candidate:
                            quick_candidates.append(candidate)

                    except Exception as e:
                        debug(f"Ошибка быстрого анализа {ticker}: {e}")

                if quick_candidates:
                    info(f"⚡ Найдено {len(quick_candidates)} быстрых кандидатов")
                    quick_candidates.sort(key=lambda x: x.rank_score, reverse=True)

                    for candidate in quick_candidates[:3]:
                        if await self._try_open_quick_position(candidate, total_capital, available):
                            break
                else:
                    debug("⚡ Быстрых кандидатов не найдено")

                # ========== 5. ПРОВЕРКА МАРЖИ ==========
                info("📊 [5/11] ПРОВЕРКА МАРЖИ...")
                margin_rate = self._check_margin()

                if margin_rate > 90:
                    info(f"⚠️ ПРОПУСК ОСТАТКА ЦИКЛА: маржа {margin_rate:.1f}% > 90%")
                    info(f"   🔄 Ждём снижения маржи (30 сек)")
                    time.sleep(30)
                    continue

                # ========== ОБНОВЛЕНИЕ PROMETHEUS МЕТРИК ==========
                try:
                    from trading_bot.monitoring.prometheus_metrics import prometheus_metrics

                    # Статус бота (1 = работает)
                    prometheus_metrics.set_bot_status(1)

                    # Портфель
                    if total_capital > 0:
                        prometheus_metrics.set_portfolio_value(float(total_capital))
                        prometheus_metrics.set_portfolio_cash(float(available))
                        prometheus_metrics.set_positions_count(float(current_positions))

                    # PnL (рассчитываем из позиций)
                    if current_positions > 0:
                        total_pnl = 0.0
                        for pos in positions:
                            if not isinstance(pos, dict):
                                continue
                            figi = pos.get('figi', 'unknown')
                            qty = pos.get('quantity', 0)
                            avg = pos.get('avg_price', 0)
                            cur = _get_tbank().get_current_price(figi)
                            if cur:
                                if qty < 0:  # SHORT
                                    pnl = (avg - cur) * abs(qty)
                                else:  # LONG
                                    pnl = (cur - avg) * qty
                                total_pnl += pnl
                        prometheus_metrics.set_daily_pnl(float(total_pnl))

                    # Маржа (теперь margin_rate определена)
                    if margin_rate > 0:
                        prometheus_metrics.set_margin_rate(float(margin_rate))

                    # Аптайм (в секундах)
                    if not hasattr(self, '_start_time'):
                        self._start_time = time.time()
                    uptime = time.time() - self._start_time
                    prometheus_metrics.set_bot_uptime(uptime)

                    debug(
                        f"   📈 Метрики обновлены: капитал={total_capital:.0f}, позиций={current_positions}, маржа={margin_rate:.1f}%")

                except Exception as e:
                    debug(f"⚠️ Ошибка обновления Prometheus метрик: {e}")

                # ========== 5.1 ЛОГИРОВАНИЕ СТАТУСА ==========
                self._log_status(total_capital, current_positions, margin_rate)

                # ========== 5.5 MARGIN GUARD ==========
                info("🛡️ [5.5/11] MARGIN GUARD...")
                try:
                    from trading_bot.risk.margin_guard import margin_guard
                    margin_guard.check_and_alert()
                    debug(f"   ✅ Margin guard проверен")
                except ImportError:
                    debug(f"   ⏭️ Margin guard не доступен (импорт не удался)")
                except Exception as e:
                    debug(f"   ⚠️ Margin guard error: {e}")

                # ========== 6. ЗАКРЫТИЕ ПОЗИЦИЙ ПРИ НЕОБХОДИМОСТИ ==========
                info("🔒 [6/11] ПРОВЕРКА НЕОБХОДИМОСТИ ЗАКРЫТИЯ...")
                self._close_positions_if_needed(positions)

                # ========== 7. ОТКРЫТИЕ НОВЫХ ПОЗИЦИЙ ==========
                info("🔍 [7/11] ПОИСК СИГНАЛОВ...")
                await self._open_positions(total_capital, available, current_positions)

                # ========== 8. ПРОВЕРКА СТОП-ЛОССОВ И ТЕЙК-ПРОФИТОВ ==========
                info("🎯 [8/11] ПРОВЕРКА TP/SL...")
                self._check_positions()

                # ========== 8.5 БАЛАНСИРОВКА ПОЗИЦИЙ ==========
                info("⚖️ [8.5/11] БАЛАНСИРОВКА ПОЗИЦИЙ...")
                self._rebalance_positions_if_needed()

                # ========== УСИЛЕНИЕ ПРИБЫЛЬНЫХ ПОЗИЦИЙ ==========
                info("💪 [8.6/11] УСИЛЕНИЕ ПРИБЫЛЬНЫХ ПОЗИЦИЙ...")

                try:
                    from trading_bot.trading.position_enhancer import get_position_enhancer
                    enhancer = get_position_enhancer(self.bot)

                    if enhancer:
                        from trading_bot.risk.position_manager import position_manager
                        positions_pm = position_manager.get_all_positions()

                        enhanced_count = 0
                        for figi, position in positions_pm.items():
                            current_price = _get_tbank().get_current_price(figi)
                            if not current_price:
                                continue

                            if position.side.value == "LONG":
                                profit_pct = (current_price - position.avg_price) / position.avg_price * 100
                            else:
                                profit_pct = (position.avg_price - current_price) / position.avg_price * 100

                            if profit_pct > 1.5:
                                result = await enhancer.check_and_enhance(position, current_price, profit_pct)
                                if result:
                                    enhanced_count += 1

                        if enhanced_count > 0:
                            success(f"   ✅ Усилено позиций: {enhanced_count}")
                        else:
                            debug(f"   ⏸️ Нет позиций для усиления")

                except ImportError as e:
                    debug(f"   ⏭️ PositionEnhancer не доступен: {e}")
                except Exception as e:
                    debug(f"   ⚠️ Ошибка в усилителе позиций: {e}")

                # ========== ОЧИСТКА ЗАСТРЯВШИХ ПОЗИЦИЙ ==========
                if hasattr(self.bot, 'position_manager') and self.bot.position_manager:
                    cleaned = self.bot.position_manager.cleanup_stuck_positions()
                    if cleaned > 0:
                        info(f"🧹 Очищено {cleaned} застрявших позиций")
                    self.bot.position_manager.check_eternal_positions(max_hold_minutes=120)

                if hasattr(self.bot, 'position_manager') and self.bot.position_manager:
                    self.bot.position_manager.check_uncovered_positions_before_clearing()

                # ========== 9. ОТПРАВКА ЕЖЕДНЕВНОГО ОТЧЁТА ==========
                self._send_daily_report()

                # ========== 10. ОЧИСТКА ДУБЛИКАТОВ ЗАЯВОК ==========
                info("🧹 [9/11] ОЧИСТКА ДУБЛИКАТОВ ЗАЯВОК...")
                self._cleanup_duplicate_orders()

                # ========== 11. ОЧИСТКА УСТАРЕВШИХ ЗАЯВОК ==========
                info("⏰ [10/11] ОЧИСТКА УСТАРЕВШИХ ЗАЯВОК...")
                self._cleanup_stale_limit_orders()

                # ========== 12. ПАУЗА ДО СЛЕДУЮЩЕГО ЦИКЛА ==========
                cycle_time = time.time() - cycle_start
                sleep_time = max(1, config.adaptive_cycle_seconds - cycle_time)

                info(f"⏳ [11/11] ПАУЗА: {sleep_time:.1f} сек (цикл занял {cycle_time:.1f} сек)")
                info(f"   {'=' * 50}")
                time.sleep(sleep_time)

            except Exception as e:
                error(f"❌ КРИТИЧЕСКАЯ ОШИБКА В ТОРГОВОМ ЦИКЛЕ: {e}")
                self._consecutive_errors += 1

                import traceback
                error(f"   📋 Трассировка:\n{traceback.format_exc()}")

                if self._consecutive_errors >= 5:
                    warning("🚨 СЛИШКОМ МНОГО ОШИБОК! Перезапускаем соединение с API...")
                    try:
                        from trading_bot.api.tbank_client import tbank
                        tbank._candles_cache.clear()
                        tbank._shares_cache = None
                        tbank._ticker_cache.clear()
                        tbank._margin_cache = None
                        info("   ✅ Кэши очищены, соединение перезапущено")
                        self._consecutive_errors = 0
                    except Exception as restart_error:
                        error(f"   ❌ Ошибка перезапуска: {restart_error}")

                time.sleep(min(60, 10 * self._consecutive_errors))

        info("🛑 TradingLoop остановлен")

    def _get_top_liquid_tickers(self, limit: int = 10) -> List[str]:
        """
        Получение топ-N самых ликвидных тикеров на основе объёма торгов в рублях
        Динамически обновляется каждый час
        """
        from trading_bot.api.tbank_client import tbank

        cache_ttl = 3600  # 1 час

        # Проверяем кэш
        if hasattr(self, '_top_tickers_cache') and self._top_tickers_cache:
            cache_time = getattr(self, '_top_tickers_cache_time', 0)
            if time.time() - cache_time < cache_ttl:
                return self._top_tickers_cache[:limit]

        try:
            # Получаем все акции
            all_shares = tbank.get_all_shares(limit=500)

            liquid_shares = []

            for share in all_shares:
                # Только рублёвые акции
                if share.get('currency') != 'rub':
                    continue

                ticker = share.get('ticker')
                if not ticker:
                    continue

                # Пытаемся получить цену
                figi = share.get('figi')
                if not figi:
                    continue

                # Получаем реальную текущую цену
                current_price = tbank.get_current_price(figi)
                if not current_price or current_price <= 0:
                    # Если не получили цену, пробуем из данных
                    current_price = share.get('price', 0) or share.get('last_price', 0) or 0

                lot = share.get('lot', 1)

                # Оценка ликвидности: цена * лот (чем дороже лот, тем ликвиднее)
                liquidity_score = current_price * lot

                if liquidity_score > 0:
                    liquid_shares.append((ticker, liquidity_score))
                    debug(f"   {ticker}: цена={current_price:.2f}, лот={lot}, ликвидность={liquidity_score:.0f}")

            # Сортируем по ликвидности (от большего к меньшему)
            liquid_shares.sort(key=lambda x: x[1], reverse=True)

            # Берём топ-N
            top_tickers = [ticker for ticker, _ in liquid_shares[:limit]]

            # Сохраняем в кэш
            self._top_tickers_cache = top_tickers
            self._top_tickers_cache_time = time.time()

            if top_tickers:
                info(f"📊 Динамический топ-{limit} ликвидных тикеров: {', '.join(top_tickers[:5])}")
            else:
                # Если ничего не нашли, используем fallback
                fallback = ["SBER", "GAZP", "LKOH", "ROSN", "TATN", "NVTK", "MGNT", "ALRS", "AFLT", "VTBR"]
                warning("⚠️ Не удалось определить топ тикеры, используем базовый список")
                return fallback[:limit]

            # После сбора liquid_shares, добавьте:
            info(f"DEBUG: собрано {len(liquid_shares)} тикеров с ликвидностью")

            if liquid_shares:
                # Выводим топ-10 для проверки
                top_10 = sorted(liquid_shares, key=lambda x: x[1], reverse=True)[:10]
                for ticker, score in top_10:
                    info(f"   {ticker}: {score:.0f}")

            return top_tickers

        except Exception as e:
            warning(f"⚠️ Ошибка получения топ-тикеров: {e}")
            # Fallback
            fallback = ["SBER", "GAZP", "LKOH", "ROSN", "TATN", "NVTK", "MGNT", "ALRS", "AFLT", "VTBR"]
            return fallback[:limit]

    async def _try_open_quick_position(self, candidate, total_capital, available_funds) -> bool:
        """Попытка открыть позицию по быстрому кандидату"""
        from trading_bot.risk.position_manager import position_manager
        from trading_bot.config import config

        ticker = candidate.ticker

        # Проверка существующей позиции
        if position_manager.get_position(candidate.figi):
            debug(f"⏸️ {ticker}: позиция уже существует")
            return False

        # Проверка лимитов с учётом капитала
        current_positions = len(self.bot._get_positions())
        max_positions = getattr(config, 'max_positions', 5)

        # Динамический лимит на основе капитала (если total_capital маленький)
        if total_capital < 10000:
            max_positions = min(max_positions, 3)
        elif total_capital < 20000:
            max_positions = min(max_positions, 4)

        if current_positions >= max_positions:
            debug(f"⏸️ {ticker}: лимит позиций достигнут ({current_positions}/{max_positions})")
            return False

        # Расчёт размера позиции с учётом капитала
        quantity = self.bot.position_sizer.calculate(candidate, available_funds, candidate.analysis.score)
        if quantity <= 0:
            debug(f"⏸️ {ticker}: размер позиции = {quantity}")
            return False

        candidate.quantity = quantity

        # Проверка достаточности средств
        total_cost = quantity * candidate.price
        if total_cost > available_funds * 0.95:
            debug(f"⏸️ {ticker}: недостаточно средств ({total_cost:.0f}₽ > {available_funds:.0f}₽)")
            return False

        # Дополнительная проверка: размер позиции не должен превышать 30% капитала
        position_pct = (total_cost / total_capital * 100) if total_capital > 0 else 100
        if position_pct > 30:
            debug(f"⏸️ {ticker}: позиция слишком большая ({position_pct:.0f}% капитала)")
            return False

        # Открываем позицию
        info(
            f"🚀 БЫСТРОЕ ОТКРЫТИЕ {ticker} (score={candidate.analysis.score}, side={candidate.side.value}, капитал={total_capital:.0f}₽)")

        if candidate.side == OrderSide.LONG or candidate.side.value == "LONG":
            success = self.bot.position_opener.open_long_market(candidate, quantity)
        else:
            success = self.bot.position_opener.open_short_market(candidate, quantity)

        if success:
            success(f"✅ {ticker}: позиция открыта через быстрый анализ!")
            return True
        else:
            error(f"❌ {ticker}: не удалось открыть позицию")
            return False

    def _load_settings(self) -> dict:
        """Загрузка текущих настроек"""
        from trading_bot.core.settings_manager import settings_manager
        return {
            'fundamental_enabled': settings_manager.get('fundamental_enabled', True),
            'technical_enabled': settings_manager.get('technical_enabled', True),
            'news_enabled': settings_manager.get('news_enabled', True),
            'candle_analysis': settings_manager.get('candle_analysis', True),
            'correlation_analysis': settings_manager.get('correlation_analysis', True),
            'use_fundamental_in_trading': settings_manager.get('use_fundamental_in_trading', True),
            'use_scalping': settings_manager.get('use_scalping', True),
            'use_swing': settings_manager.get('use_swing', True),
            'use_position': settings_manager.get('use_position', False),
            'use_margin': settings_manager.get('use_margin', False),
            'aggressiveness': settings_manager.get('aggressiveness', 5),
            'risk_per_trade': settings_manager.get('risk_per_trade', 0.05),
            'short_enabled': settings_manager.get('use_short', False),
        }

    def _on_setting_changed(self, key: str, value: Any):
        """Обработчик изменения настройки"""
        if key in self._active_settings:
            self._active_settings[key] = value
            info(f"🔄 Настройка {key} обновлена в TradingLoop: {value}")

            if key == 'fundamental_enabled':
                from trading_bot.analysis.fundamental_analyzer import fundamental_analyzer
                fundamental_analyzer.enabled = value
                info(f"   📊 FundamentalAnalyzer.enabled = {value}")
            elif key == 'news_enabled':
                from trading_bot.analysis.news_sentiment import news_sentiment
                news_sentiment.enabled = value
                info(f"   📰 NewsAnalyzer.enabled = {value}")
            elif key == 'use_fundamental_in_trading':
                if hasattr(self.bot, 'use_fundamental_in_trading'):
                    self.bot.use_fundamental_in_trading = value

    # ==================== ОЧИСТКА ДУБЛИКАТОВ ====================

    def force_cleanup_all_orders(self, reason: str = "manual"):
        """ПРИНУДИТЕЛЬНАЯ ОЧИСТКА ВСЕХ ЗАЯВОК (для критических ситуаций)"""
        try:
            from trading_bot.api.tbank_client import tbank

            warning(f"⚠️ ПРИНУДИТЕЛЬНАЯ ОЧИСТКА ВСЕХ ЗАЯВОК: {reason}")

            active_orders = tbank.get_active_orders()
            if not active_orders:
                info("   ✅ Нет активных заявок")
                return

            cancelled = 0
            for order in active_orders:
                order_id = order.get('order_id')
                ticker = order.get('ticker', 'unknown')

                if tbank.cancel_order(order_id):
                    cancelled += 1
                    info(f"   🧹 Отменена заявка {ticker}: {order.get('direction')}")
                else:
                    error(f"   ❌ Не удалось отменить {ticker}")

            info(f"   📊 Принудительно отменено заявок: {cancelled}/{len(active_orders)}")

            try:
                from trading_bot.risk.position_manager import position_manager
                position_manager.sync_with_broker()
                info("   🔄 Позиции синхронизированы после принудительной очистки")
            except:
                pass

        except Exception as e:
            error(f"❌ Ошибка принудительной очистки: {e}")

    def _cleanup_duplicate_orders(self):
        """ОЧИСТКА ДУБЛИРУЮЩИХСЯ ЗАЯВОК - ИСПРАВЛЕННАЯ ВЕРСИЯ"""
        from trading_bot.api.tbank_client import tbank

        current_time = time.time()
        if current_time - self._last_cleanup_time < self._cleanup_cooldown:
            debug(f"   ⏸️ Очистка дубликатов: пропускаем (cooldown {self._cleanup_cooldown} сек)")
            return

        self._last_cleanup_time = current_time

        try:
            info("   🧹 ЗАПУСК ОЧИСТКИ ДУБЛИРУЮЩИХСЯ ЗАЯВОК...")

            try:
                available_before, total_before, _ = tbank.get_available_funds()
                margin_info_before = tbank.get_margin_info()
                used_margin_before = margin_info_before.get('used_margin', 0)
            except Exception:
                available_before = 0
                used_margin_before = 0

            result = tbank.cancel_all_duplicate_orders()

            cancelled = result.get('cancelled', 0)
            failed = result.get('failed', 0)

            if cancelled > 0:
                success(f"   ✅ ОТМЕНЕНО дублирующихся заявок: {cancelled}")

                time.sleep(0.5)

                try:
                    available_after, total_after, _ = tbank.get_available_funds()
                    margin_info_after = tbank.get_margin_info()
                    used_margin_after = margin_info_after.get('used_margin', 0)

                    freed_funds = available_after - available_before
                    freed_margin = used_margin_before - used_margin_after

                    if freed_funds > 0 or freed_margin > 0:
                        info(f"   💰 ОСВОБОДИЛОСЬ: +{freed_funds:.2f}₽ средств, -{freed_margin:.2f}₽ маржи")
                except Exception as e:
                    debug(f"   Не удалось рассчитать освободившиеся средства: {e}")

                try:
                    from trading_bot.risk.position_manager import position_manager
                    position_manager.sync_with_broker()
                except Exception:
                    pass

            elif failed > 0:
                warning(f"   ⚠️ НЕ УДАЛОСЬ отменить {failed} заявок")
            else:
                info("   ✅ Дублирующихся заявок не найдено")

        except Exception as e:
            error(f"   ❌ Ошибка при очистке дублирующихся заявок: {e}")
            import traceback
            debug(f"   {traceback.format_exc()}")

    def _cleanup_stale_limit_orders(self):
        """Отмена лимитных заявок, которые висят слишком долго"""
        from trading_bot.api.tbank_client import tbank
        from trading_bot.utils.time_utils import get_moscow_time
        from datetime import datetime

        try:
            orders = tbank.get_active_orders()
            if not orders:
                debug(f"   📭 Нет активных заявок для очистки")
                return

            now = get_moscow_time()
            cancelled = 0
            MAX_ORDER_AGE_SECONDS = 3600

            info(f"   🔍 Проверка {len(orders)} заявок на устаревание...")

            for order in orders:
                created_at = order.get('created_at')
                if not created_at:
                    continue

                if isinstance(created_at, str):
                    try:
                        created_at = datetime.fromisoformat(created_at.replace('Z', '+00:00'))
                    except ValueError:
                        continue

                if created_at and (now - created_at).total_seconds() > MAX_ORDER_AGE_SECONDS:
                    ticker = order.get('ticker', 'unknown')
                    order_id = order.get('order_id')
                    age_minutes = int((now - created_at).total_seconds() / 60)

                    info(
                        f"      🧹 Отмена устаревшей заявки: {ticker} ({order.get('direction')} {order.get('quantity')}шт по {order.get('price', 0):.2f}₽, висела {age_minutes} мин)")

                    if tbank.cancel_order(order_id):
                        cancelled += 1
                    else:
                        warning(f"      ⚠️ Не удалось отменить устаревшую заявку {ticker}")

            if cancelled > 0:
                info(f"   ✅ Очистка завершена: отменено {cancelled} устаревших заявок")
            else:
                debug(f"   ✅ Устаревших заявок не найдено")

        except Exception as e:
            debug(f"   ⚠️ Ошибка при очистке устаревших заявок: {e}")

    # ==================== ЕЖЕДНЕВНЫЙ ОТЧЁТ ====================

    def _send_daily_report(self):
        """Отправка ежедневного отчёта в Telegram"""
        try:
            now = get_moscow_time()

            if self._last_report_date != now.date():
                self._last_report_date = now.date()

                info(f"📊 Формирование ежедневного отчёта за {now.strftime('%d.%m.%Y')}...")

                positions = _get_tbank().get_positions(force_refresh=True)
                available, total, _ = _get_tbank().get_available_funds()
                margin_info = _get_tbank().get_margin_info()
                margin_rate = margin_info.get('margin_rate', 0)

                total_pnl = 0
                for pos in positions:
                    figi = pos.get('figi', 'unknown')
                    qty = pos.get('quantity', 0)
                    avg = pos.get('avg_price', 0)
                    cur = _get_tbank().get_current_price(figi)
                    if cur:
                        if qty < 0:
                            total_pnl += (avg - cur) * abs(qty)
                        else:
                            total_pnl += (cur - avg) * qty

                report = (
                    f"📊 **ЕЖЕДНЕВНЫЙ ОТЧЁТ БОТА**\n"
                    f"━━━━━━━━━━━━━━━━━━━━━━━\n"
                    f"📅 Дата: {now.strftime('%d.%m.%Y')}\n"
                    f"💰 Капитал: {total:.0f}₽\n"
                    f"📈 Открыто позиций: {len(positions)}\n"
                    f"📊 Маржа: {margin_rate:.1f}%\n"
                    f"💵 Текущий P&L: {total_pnl:+.2f}₽\n"
                    f"🔄 Циклов сегодня: {self._cycle_count}\n"
                    f"━━━━━━━━━━━━━━━━━━━━━━━\n"
                    f"✅ Бот работает стабильно"
                )

                telegram = _get_telegram()
                if telegram:
                    telegram.send_message(report)
                    info("   📨 Ежедневный отчёт отправлен в Telegram")
                else:
                    info(f"   📨 {report}")

        except Exception as e:
            debug(f"   ⚠️ Ошибка отправки отчёта: {e}")

    # ==================== ОСТАЛЬНЫЕ МЕТОДЫ ====================

    def _sync_positions(self):
        """Синхронизация позиций при старте"""
        try:
            from trading_bot.risk.position_manager import position_manager
            position_manager.sync_with_broker()
            info("📊 Позиции синхронизированы с брокером")
        except Exception as e:
            warning(f"⚠️ Ошибка синхронизации позиций: {e}")

    def _is_trading_time(self) -> bool:
        """Проверка, можно ли торговать сейчас"""
        from ..utils.time_utils import (
            get_moscow_time,
            is_pre_market_time,
            is_main_session_time,
            is_evening_session_time,
            is_technical_break,
            is_weekend_trading_time,
            is_dsvd_trading_time,
            is_holiday,
        )
        from ..config import config

        now = get_moscow_time()
        weekday = now.weekday()
        is_weekend = weekday >= 5

        if is_holiday(now):
            # В праздник торгуем ТОЛЬКО в часы ДСВД
            if is_dsvd_trading_time():
                debug(f"   🎉 Праздничный день, ДСВД активна - торговля разрешена")
                # Не возвращаем False, продолжаем проверку
            else:
                debug(f"   🎄 Праздничный день, ДСВД не активна - торговля запрещена")
                return False

        if is_technical_break():
            debug(f"   ⏸️ Технический перерыв - торговля запрещена")
            return False

        if is_weekend and is_weekend_trading_time():
            config.is_weekend_session = True
            config.is_otc_mode = False
            debug(f"   📊 ДОПОЛНИТЕЛЬНАЯ СЕССИЯ ВЫХОДНОГО ДНЯ (ДСВД): торговля разрешена")
            return True

        if not is_weekend:
            if is_main_session_time() or is_pre_market_time() or is_evening_session_time():
                config.is_weekend_session = False
                config.is_otc_mode = False
                return True

        if is_weekend and not is_weekend_trading_time():
            debug(f"   🌙 Выходной день, ДСВД не активна - торговля запрещена")
            config.is_weekend_session = False
            config.is_otc_mode = False
            return False

        debug(f"   ⏸️ Торговля запрещена")
        return False

    def _adaptive_configuration(self, total_capital: float):
        """Адаптивная настройка под капитал"""
        mode = config.get_capital_mode(total_capital)

        config.long_score_threshold = config.get_adaptive_long_threshold(total_capital)
        config.adaptive_position_size_pct = config.get_adaptive_position_size(total_capital)
        config.stop_loss_pct = config.get_adaptive_stop_loss(total_capital)
        config.take_profit_pct = config.get_adaptive_take_profit(total_capital)
        config.adaptive_cycle_seconds = config.get_adaptive_cycle(total_capital)
        config.min_trade_amount = config.get_adaptive_min_trade_amount(total_capital)
        config.max_positions = config.get_adaptive_max_positions(total_capital)
        config.total_capital = total_capital

        info(f"   ⚙️ Адаптация: {mode.get('message', 'unknown')}, "
             f"позиций={config.max_positions}, "
             f"размер={config.adaptive_position_size_pct * 100:.1f}%, "
             f"SL={config.stop_loss_pct:.2f}%, TP={config.take_profit_pct:.1f}%, "
             f"SHORT={config.use_short}")

    def _check_margin(self) -> float:
        """Умная проверка маржи - использует интеллектуальный анализ позиций"""
        from trading_bot.logger import info, success, error, warning, debug

        try:
            margin_info = _get_tbank().get_margin_info()
            margin_rate = margin_info.get('margin_rate', 0) if margin_info else 0

            # ✅ Получаем реальные позиции для анализа
            positions = self.bot._get_positions(force_refresh=True)
            current_positions = len(positions)

            # Получаем капитал для уведомлений
            _, total_capital, _ = _get_tbank().get_available_funds()

            # ========== ЭКСТРЕННЫЙ РЕЖИМ (≥95%) ==========
            if margin_rate >= 95:
                error(f"🔥 ЭКСТРЕННЫЙ РЕЖИМ: маржа {margin_rate:.1f}%! Позиций: {current_positions}")
                info(f"   🧠 Запуск интеллектуального анализа всех позиций...")

                # ✅ ИСПРАВЛЕНО: используем существующий метод
                closed = position_closer.close_worst_positions(max_to_close=3)

                if closed > 0:
                    success(f"✅ Интеллектуально закрыто {closed} позиций")
                else:
                    info(f"   ℹ️ Умная логика решила не закрывать ни одной позиции")
                    info(f"   💚 Все позиции остаются согласно анализу")

                # Telegram уведомление (не чаще раза в час)
                if not hasattr(self, '_emergency_margin_notified') or not self._emergency_margin_notified:
                    telegram = _get_telegram()
                    if telegram:
                        # Рассчитываем примерный убыток
                        total_pnl = 0
                        for pos in positions:
                            figi = pos.get('figi')
                            if figi:
                                current_price = _get_tbank().get_current_price(figi)
                                if current_price:
                                    qty = pos.get('quantity', 0)
                                    avg = pos.get('avg_price', 0)
                                    if qty > 0:
                                        total_pnl += (current_price - avg) * qty
                                    else:
                                        total_pnl += (avg - current_price) * abs(qty)

                        message = (
                            f"🚨 **ЭКСТРЕННЫЙ РЕЖИМ!**\n\n"
                            f"📊 Маржа: **{margin_rate:.1f}%**\n"
                            f"💰 Капитал: {total_capital:.0f}₽\n"
                            f"📈 Открыто позиций: {current_positions}\n"
                            f"📉 Текущий P&L: {total_pnl:+.0f}₽\n\n"
                            f"⚠️ **Рекомендации:**\n"
                            f"• Пополните счёт на 1000-2000₽\n"
                            f"• Или закройте убыточные позиции вручную\n"
                            f"• OTC-инструменты (SGZH, FIXR) требуют ручного закрытия!"
                        )
                        telegram.send_error(message)
                        self._emergency_margin_notified = True
                        info("   📱 Уведомление отправлено в Telegram")

            # ========== КРИТИЧЕСКАЯ МАРЖА (85-94%) ==========
            elif margin_rate >= 85:
                error(f"🔥 КРИТИЧЕСКАЯ МАРЖА: {margin_rate:.1f}%! Позиций: {current_positions}")
                info(f"   🧠 Запуск интеллектуального анализа убыточных позиций...")

                # ✅ ИСПРАВЛЕНО: закрываем 2 худшие позиции
                closed = position_closer.close_worst_positions(max_to_close=2)

                if closed > 0:
                    success(f"✅ Интеллектуально закрыто {closed} убыточных позиций")
                else:
                    info(f"   ℹ️ Умная логика решила не закрывать ни одной позиции")

                # Telegram уведомление (не чаще раза в час)
                if not hasattr(self, '_critical_margin_notified') or not self._critical_margin_notified:
                    telegram = _get_telegram()
                    if telegram:
                        message = (
                            f"⚠️ **КРИТИЧЕСКАЯ МАРЖА!**\n\n"
                            f"📊 Маржа: **{margin_rate:.1f}%**\n"
                            f"💰 Капитал: {total_capital:.0f}₽\n"
                            f"📈 Открыто позиций: {current_positions}\n\n"
                            f"🔄 Автоматически закрыто позиций: {closed}\n\n"
                            f"💡 Рекомендуется пополнить счёт."
                        )
                        telegram.send_error(message)
                        self._critical_margin_notified = True
                        info("   📱 Уведомление отправлено в Telegram")

            # ========== ОПАСНАЯ МАРЖА (75-84%) ==========
            elif margin_rate >= 75:
                warning(f"⚠️ ОПАСНАЯ МАРЖА: {margin_rate:.1f}%")
                # ✅ ИСПРАВЛЕНО: закрываем 1 самую убыточную позицию
                closed = position_closer.close_worst_positions(max_to_close=1)
                if closed > 0:
                    success(f"✅ Закрыта {closed} самая убыточная позиция")

                # Сбрасываем флаги уведомлений
                self._critical_margin_notified = False
                self._emergency_margin_notified = False

            # ========== ВЫСОКАЯ МАРЖА (70-74%) ==========
            elif margin_rate >= 70:
                warning(f"⚠️ ВЫСОКАЯ МАРЖА: {margin_rate:.1f}% (следим)")
                self._critical_margin_notified = False
                self._emergency_margin_notified = False

            # ========== НОРМАЛЬНАЯ МАРЖА ==========
            else:
                debug(f"📊 МАРЖА: {margin_rate:.1f}% (норма)")
                self._critical_margin_notified = False
                self._emergency_margin_notified = False

            return margin_rate or 0

        except Exception as e:
            debug(f"Ошибка проверки маржи: {e}")
            return 0

    def _emergency_close_profitable_only(self) -> int:
        """
        АВАРИЙНОЕ ЗАКРЫТИЕ - использует умную логику для каждого тикера

        Логика:
        1. При критической марже (>85%) - анализируем КАЖДУЮ позицию через умную логику
        2. Не хардкодим "закрыть всё" - доверяемся интеллектуальному анализу
        3. Отправляем детальное уведомление в Telegram
        """
        from trading_bot.risk.position_manager import position_manager
        from trading_bot.api.tbank_client import tbank
        from trading_bot.utils.time_utils import get_moscow_time

        # ✅ ДОБАВЛЕНО: логирование входа в метод
        info(f"\n{'🔴' * 50}")
        info(f"🔥🔥🔥 МЕТОД _emergency_close_profitable_only ВЫЗВАН! 🔥🔥🔥")
        info(f"{'🔴' * 50}")

        info(f"\n{'=' * 70}")
        info(f"🚨 АВАРИЙНОЕ ЗАКРЫТИЕ - КРИТИЧЕСКАЯ МАРЖА")
        info(f"   Время: {get_moscow_time().strftime('%H:%M:%S')}")
        info(f"{'=' * 70}")

        try:
            # 1. Получаем текущую маржу
            info("📊 [1/9] ПОЛУЧЕНИЕ МАРЖИ...")
            margin_info = tbank.get_margin_info()
            margin_rate = margin_info.get('margin_rate', 0)
            available_margin = margin_info.get('available_margin', 0)
            used_margin = margin_info.get('used_margin', 0)
            liquid_portfolio = margin_info.get('liquid_portfolio', 0)

            info(f"📊 ТЕКУЩЕЕ СОСТОЯНИЕ МАРЖИ:")
            info(f"   💰 Ликвидный портфель: {liquid_portfolio:.2f}₽")
            info(f"   🔒 Использовано маржи: {used_margin:.2f}₽")
            info(f"   ✅ Доступно маржи: {available_margin:.2f}₽")
            info(f"   📈 Ставка маржи: {margin_rate:.1f}%")

            # 2. Получаем все позиции
            info("📊 [2/9] ПОЛУЧЕНИЕ ПОЗИЦИЙ ОТ БРОКЕРА...")
            positions = _get_tbank().get_positions(force_refresh=True)

            info(f"   📊 positions = {positions}")
            info(f"   📊 type(positions) = {type(positions)}")
            info(f"   📊 len(positions) = {len(positions) if positions else 0}")

            if not positions:
                info(f"   📭 Нет открытых позиций")
                return 0

            info(f"\n📊 [3/9] АНАЛИЗ ПОЗИЦИЙ ({len(positions)} шт) ПРИ МАРЖЕ {margin_rate:.1f}%:")
            info(f"{'─' * 50}")

            # 3. Собираем данные по позициям с P&L
            positions_data = []
            total_pnl = 0
            profitable_count = 0
            losing_count = 0

            for idx, pos in enumerate(positions):
                info(f"   🔍 [{idx + 1}] Обработка позиции...")

                figi = pos.get('figi')
                if not figi:
                    info(f"      ⚠️ Нет FIGI, пропускаем")
                    continue

                current_price = tbank.get_current_price(figi)
                ticker = pos.get('ticker') or figi[:8]
                quantity = pos.get('quantity', 0)
                avg_price = pos.get('avg_price', 0)

                info(f"      ticker={ticker}, quantity={quantity}, avg={avg_price}, current={current_price}")

                if quantity == 0:
                    info(f"      ⚠️ quantity=0, пропускаем")
                    continue

                side = "LONG" if quantity > 0 else "SHORT"
                abs_qty = abs(quantity)
                position_value = abs_qty * (current_price or avg_price)

                if current_price:
                    if quantity > 0:  # LONG
                        profit_pct = (current_price - avg_price) / avg_price * 100 if avg_price > 0 else 0
                        profit_amount = (current_price - avg_price) * abs_qty
                    else:  # SHORT
                        profit_pct = (avg_price - current_price) / avg_price * 100 if avg_price > 0 else 0
                        profit_amount = (avg_price - current_price) * abs_qty

                    total_pnl += profit_amount

                    positions_data.append({
                        'figi': figi,
                        'position': pos,
                        'profit_pct': profit_pct,
                        'profit_amount': profit_amount,
                        'ticker': ticker,
                        'side': side,
                        'qty': abs_qty,
                        'avg_price': avg_price,
                        'current_price': current_price,
                        'position_value': position_value
                    })

                    if profit_pct > 0:
                        profitable_count += 1
                        icon = "🟢"
                    elif profit_pct < 0:
                        losing_count += 1
                        icon = "🔴"
                    else:
                        icon = "⚪"

                    info(f"      {icon} {ticker} ({side}): {profit_pct:+.2f}% | {profit_amount:+.2f}₽")
                else:
                    warning(f"      ⚠️ {ticker}: не удалось получить цену")

            if not positions_data:
                info(f"   ❌ Нет данных по позициям")
                return 0

            # 4. Логируем общую картину
            info(f"\n{'─' * 50}")
            info(f"📊 [4/9] ОБЩАЯ КАРТИНА:")
            info(f"   🟢 Прибыльных позиций: {profitable_count}")
            info(f"   🔴 Убыточных позиций: {losing_count}")
            info(f"   💰 Общий P&L: {total_pnl:+.2f}₽")
            info(f"   📈 Маржа: {margin_rate:.1f}%")

            # 5. Получаем рыночные условия для умного анализа
            info("📊 [5/9] ПОЛУЧЕНИЕ РЫНОЧНЫХ УСЛОВИЙ...")
            market_conditions = self._get_market_conditions_for_weekend()
            total_capital = getattr(self.bot, 'total_capital', liquid_portfolio)
            info(f"   total_capital = {total_capital}")

            info(f"\n🔍 [6/9] ИНТЕЛЛЕКТУАЛЬНЫЙ АНАЛИЗ КАЖДОЙ ПОЗИЦИИ:")
            info(f"{'─' * 70}")

            # 6. Анализируем каждую позицию через умную логику
            decisions = []
            for item in positions_data:
                ticker = item['ticker']
                side = item['side']
                profit_pct = item['profit_pct']

                info(f"\n📌 АНАЛИЗ {ticker} ({side}):")
                info(f"   📊 Текущий P&L: {profit_pct:+.2f}%")
                info(f"   📈 Текущая маржа: {margin_rate:.1f}%")

                try:
                    should_close, reason, confidence, details = self._should_close_position_smart_detailed(
                        ticker=ticker,
                        figi=item['figi'],
                        side=side,
                        qty=item['qty'],
                        profit_pct=profit_pct,
                        pnl=item['profit_amount'],
                        position_value=item['position_value'],
                        current_price=item['current_price'],
                        avg_price=item['avg_price'],
                        market_conditions=market_conditions,
                        total_portfolio_pnl=total_pnl,
                        max_overnight=999999,
                        total_capital=total_capital
                    )
                    info(f"   ✅ Умный анализ выполнен")
                except Exception as e:
                    error(f"   ❌ ОШИБКА в умном анализе {ticker}: {e}")
                    import traceback
                    error(f"      {traceback.format_exc()}")
                    continue

                for detail in details[:5]:
                    info(f"   {detail}")

                info(f"   🧠 РЕШЕНИЕ: {'🔒 ЗАКРЫТЬ' if should_close else '⏸️ ОСТАВИТЬ'}")
                info(f"   📊 Уверенность: {confidence:.0%}")
                info(f"   💬 Причина: {reason}")

                decisions.append({
                    **item,
                    'should_close': should_close,
                    'reason': reason,
                    'confidence': confidence
                })

            # 7. Закрываем только те позиции, для которых умная логика сказала "ЗАКРЫТЬ"
            closing_items = [d for d in decisions if d['should_close']]

            if not closing_items:
                info(f"\n✅ [7/9] РЕШЕНИЕ: НЕТ ПОЗИЦИЙ ДЛЯ ЗАКРЫТИЯ")
                info(f"   💚 Умная логика решила оставить все {len(decisions)} позиций")
                return 0

            info(f"\n{'⚠️' * 35}")
            info(f"⚠️ [7/9] ЗАКРЫТИЕ ПОЗИЦИЙ ПО РЕШЕНИЮ УМНОЙ ЛОГИКИ ({len(closing_items)} шт)")
            info(f"{'⚠️' * 35}")

            closed = 0
            closed_pnl = 0
            failed = 0

            long_items = [item for item in closing_items if item['side'] == "LONG"]
            short_items = [item for item in closing_items if item['side'] == "SHORT"]

            info(f"\n   📊 ПОРЯДОК ЗАКРЫТИЯ:")
            info(f"      🟢 Сначала LONG ({len(long_items)} шт)")
            info(f"      🔴 Потом SHORT ({len(short_items)} шт)")

            # ШАГ 1: LONG
            for idx, item in enumerate(long_items):
                ticker = item['ticker']
                figi = item['figi']
                position = item['position']
                profit_pct = item['profit_pct']
                profit_amount = item['profit_amount']
                side = item['side']
                reason = item['reason']
                confidence = item['confidence']

                qty = position.get('quantity', 0)

                info(f"\n   📍 [{idx + 1}/{len(long_items)}] Закрытие {ticker} ({side}):")
                info(f"      📊 P&L: {profit_pct:+.2f}% ({profit_amount:+.2f}₽)")
                info(f"      🔢 Количество: {qty} шт")
                info(f"      🔴 Действие: ПРОДАЖА {qty} шт")

                try:
                    info(f"      🔄 Вызов tbank.sell({figi}, {qty})...")
                    success_flag = tbank.sell(figi, qty, use_market=True)
                    info(f"      📊 Результат: {success_flag}")

                    if success_flag:
                        position_manager.remove_position(figi)
                        closed += 1
                        closed_pnl += profit_amount
                        success(f"      ✅ {ticker} ЗАКРЫТ!")
                    else:
                        failed += 1
                        error(f"      ❌ НЕ УДАЛОСЬ закрыть {ticker}")
                except Exception as e:
                    failed += 1
                    error(f"      ❌ ОШИБКА: {e}")

            available, _, _ = tbank.get_available_funds()
            info(f"\n   💰 ПОСЛЕ ЗАКРЫТИЯ LONG доступно: {available:.0f}₽")

            # ШАГ 2: SHORT
            for idx, item in enumerate(short_items):
                ticker = item['ticker']
                figi = item['figi']
                position = item['position']
                profit_pct = item['profit_pct']
                profit_amount = item['profit_amount']
                side = item['side']
                reason = item['reason']
                confidence = item['confidence']
                current_price = item['current_price']

                qty = position.get('quantity', 0)
                needed = qty * current_price * 1.05

                if available < needed:
                    warning(
                        f"\n   📍 Закрытие {ticker} ({side}): НЕДОСТАТОЧНО СРЕДСТВ! Нужно {needed:.0f}₽, есть {available:.0f}₽")
                    failed += 1
                    continue

                info(f"\n   📍 [{idx + 1}/{len(short_items)}] Закрытие {ticker} ({side}):")
                info(f"      🔢 Количество: {qty} шт")
                info(f"      🟢 Действие: ПОКУПКА {qty} шт")

                try:
                    info(f"      🔄 Вызов tbank.buy({figi}, {qty})...")
                    success_flag = tbank.buy(figi, qty, use_market=True)
                    info(f"      📊 Результат: {success_flag}")

                    if success_flag:
                        position_manager.remove_position(figi)
                        closed += 1
                        closed_pnl += profit_amount
                        available -= needed
                        success(f"      ✅ {ticker} ЗАКРЫТ!")
                    else:
                        failed += 1
                        error(f"      ❌ НЕ УДАЛОСЬ закрыть {ticker}")
                except Exception as e:
                    failed += 1
                    error(f"      ❌ ОШИБКА: {e}")

            # 8. Итоговый отчёт
            info(f"\n{'=' * 70}")
            info(f"📊 [8/9] ИТОГИ АВАРИЙНОГО ЗАКРЫТИЯ (МАРЖА {margin_rate:.1f}%):")
            info(f"{'=' * 70}")
            info(f"   🔒 Закрыто: {closed}")
            info(f"   ❌ Не закрыто: {failed}")
            info(f"   💰 P&L: {closed_pnl:+.2f}₽")

            kept_items = [d for d in decisions if not d['should_close']]
            if kept_items:
                info(f"\n   ⏸️ ОСТАВЛЕНЫ ПОЗИЦИИ ({len(kept_items)} шт):")
                for item in kept_items:
                    info(f"      ⏸️ {item['ticker']}: P&L={item['profit_pct']:+.2f}%")

            info(f"{'=' * 70}\n")
            return closed

        except Exception as e:
            error(f"❌ ОШИБКА в emergency_close_profitable_only: {e}")
            import traceback
            error(f"   {traceback.format_exc()}")
            return 0

    def _close_worst_positions(self, max_to_close: int = 2) -> int:
        """Закрывает самые убыточные позиции"""
        try:
            from trading_bot.risk.position_manager import position_manager
            from trading_bot.logger import success as log_success

            positions = position_manager.get_all_positions()
            if not positions:
                return 0

            positions_data = []
            for figi, pos in positions.items():
                current_price = _get_tbank().get_current_price(figi)
                if current_price:
                    profit_pct = pos.current_profit_pct(current_price)
                    positions_data.append({
                        'figi': figi,
                        'position': pos,
                        'profit_pct': profit_pct,
                        'is_profitable': profit_pct > 0
                    })

            positions_data.sort(key=lambda x: x['profit_pct'])

            closed = 0
            for item in positions_data[:max_to_close]:
                if item['profit_pct'] >= 0:
                    continue

                figi = item['figi']
                position = item['position']
                ticker = position.ticker or figi[:8]

                warning(f"🔄 Закрытие убыточной позиции {ticker} (P&L: {item['profit_pct']:.2f}%)")

                if position.side.value == "SHORT":
                    success_flag = _get_tbank().buy(figi, position.quantity)
                else:
                    success_flag = _get_tbank().sell(figi, position.quantity)

                if success_flag:
                    position_manager.remove_position(figi)
                    closed += 1
                    log_success(f"✅ Позиция {ticker} закрыта")
                else:
                    error(f"❌ Не удалось закрыть позицию {ticker}")

            return closed

        except Exception as e:
            error(f"Ошибка закрытия убыточных позиций: {e}")
            return 0

    def _close_positions_if_needed(self, positions=None):
        """Закрытие позиций при необходимости"""
        from trading_bot.utils.time_utils import get_moscow_time
        from datetime import time as dt_time

        now = get_moscow_time()
        current_time = now.time()

        # ✅ Если позиции не переданы - получаем принудительно
        if positions is None:
            positions = self.bot._get_positions(force_refresh=True)

        if self._close_weekend_positions(positions):
            return

        if not hasattr(self.bot, 'position_closer') or not self.bot.position_closer:
            debug(f"   ⏭️ PositionCloser не доступен")
            return

        MAIN_END = dt_time(18, 59)
        MAIN_CLOSE_START = dt_time(18, 54)

        if MAIN_CLOSE_START <= current_time <= MAIN_END:
            minutes_left = (18 * 60 + 59) - (current_time.hour * 60 + current_time.minute)
            if minutes_left <= 5 and minutes_left > 0:
                info(f"   🔒 До закрытия основной сессии {minutes_left} мин, закрываем позиции")
                from trading_bot.risk.position_manager import position_manager
                position_manager.close_all_positions_smart(reason=f"основная сессия {minutes_left}мин")
                return

        EVENING_END = dt_time(23, 49, 59)
        EVENING_CLOSE_START = dt_time(23, 44)

        if EVENING_CLOSE_START <= current_time <= EVENING_END:
            minutes_left = (23 * 60 + 49) - (current_time.hour * 60 + current_time.minute)
            if minutes_left <= 5 and minutes_left > 0:
                info(f"   🔒 До закрытия вечерней сессии {minutes_left} мин, закрываем позиции")
                from trading_bot.risk.position_manager import position_manager
                position_manager.close_all_positions_smart(reason=f"вечерняя сессия {minutes_left}мин")
                return

    def _check_liquidity_before_entry(self, figi: str, ticker: str, required_volume: float = 5000) -> bool:
        """Проверка ликвидности инструмента перед входом в позицию"""
        try:
            from trading_bot.api.tbank_client import tbank

            liquidity = tbank.check_liquidity(figi, required_volume=required_volume)

            if not liquidity['is_liquid']:
                warning(f"❌ Пропускаем {ticker}: {liquidity['reason']}")
                if liquidity.get('volume_rub', 0) > 0:
                    warning(f"   📊 Текущий объём: {liquidity['volume_rub']:.0f}₽ (требуется {required_volume:.0f}₽)")
                if liquidity.get('spread_pct', 0) > 0:
                    warning(
                        f"   📊 Спред: {liquidity['spread_pct']:.2f}% (максимум {liquidity.get('max_spread_pct', 3)}%)")
                return False

            debug(
                f"   ✅ {ticker}: ликвидность OK (объём={liquidity['volume_rub']:.0f}₽, спред={liquidity['spread_pct']:.2f}%)")
            return True

        except Exception as e:
            warning(f"   ⚠️ Ошибка проверки ликвидности {ticker}: {e}")
            return False

    async def _open_positions(self, total_capital: float, available_funds: float, current_positions: int):
        """Открытие новых позиций с учётом лимитов и балансировки"""
        from trading_bot.api.tbank_client import tbank
        margin_info = tbank.get_margin_info()
        margin_rate = margin_info.get('margin_rate', 0)

        if margin_rate > 80:
            info(f"   ⏸️ Маржа {margin_rate:.1f}% > 80% - открытие новых позиций запрещено")
            return

        if not self._active_settings.get('use_scalping', True) and \
                not self._active_settings.get('use_swing', True) and \
                not self._active_settings.get('use_position', False):
            info("   ⏸️ Все режимы торговли отключены в настройках")
            return

        min_auto_score = 0
        info(f"   🎯 Мин. score для автоматического открытия: {min_auto_score}")

        info(f"   📊 Активные режимы: scalping={self._active_settings.get('use_scalping')}, "
             f"swing={self._active_settings.get('use_swing')}, "
             f"position={self._active_settings.get('use_position')}")

        try:
            now = get_moscow_time()
            current_time = now.time()
            MAIN_START = dt_time(9, 50)
            MAIN_END = dt_time(18, 59)

            if MAIN_START <= current_time <= MAIN_END:
                session = "main"
            else:
                session = "evening"

            info(
                f"   🎯 ВЫЗОВ _find_and_open_positions: капитал={total_capital:.2f}, свободно={available_funds:.2f}, позиций={current_positions}, сессия={session}")

            original_check_liquidity = None
            if hasattr(self.bot, '_check_liquidity_before_entry'):
                original_check_liquidity = self.bot._check_liquidity_before_entry

            self.bot._check_liquidity_before_entry = self._check_liquidity_before_entry

            try:
                await self.bot._find_and_open_positions(
                    total_capital=total_capital,
                    available_funds=available_funds,
                    current_positions=current_positions,
                    minutes_left=0,
                    session=session,
                    min_auto_score=0,
                    trading_loop=self
                )
            finally:
                if original_check_liquidity is not None:
                    self.bot._check_liquidity_before_entry = original_check_liquidity
                elif hasattr(self.bot, '_check_liquidity_before_entry'):
                    delattr(self.bot, '_check_liquidity_before_entry')

            info(f"   ✅ _find_and_open_positions завершён")

        except Exception as e:
            error(f"   ❌ Ошибка открытия позиций: {e}")
            import traceback
            debug(f"   {traceback.format_exc()}")

    def _check_positions(self):
        """Проверка стоп-лоссов, тейк-профитов и отката от максимума с ДИНАМИЧЕСКИМ трейлинг-стопом"""
        try:
            from trading_bot.risk.position_manager import position_manager
            from trading_bot.api.tbank_client import tbank
            from ..config import config

            # Получаем все позиции
            positions = position_manager.get_all_positions()

            if not positions:
                debug(f"   📭 Нет позиций для проверки")
                return

            for figi, position in positions.items():
                current_price = tbank.get_current_price(figi)
                if not current_price:
                    warning(f"   ⚠️ {position.ticker}: не удалось получить текущую цену")
                    continue

                # ========== 1. РАСЧЁТ ТЕКУЩЕЙ ПРИБЫЛИ ==========
                if position.side.value == "LONG":
                    profit_pct = (current_price - position.avg_price) / position.avg_price * 100
                    entry_price = position.avg_price
                else:
                    profit_pct = (position.avg_price - current_price) / position.avg_price * 100
                    entry_price = position.avg_price

                # ========== 2. ПОЛУЧАЕМ ТЕХНИЧЕСКИЙ АНАЛИЗ ДЛЯ ДИНАМИЧЕСКИХ УРОВНЕЙ ==========
                tech_analysis = self._analyze_position_technicals(
                    position.ticker, figi, position.side.value,
                    current_price, position.avg_price
                )

                atr_pct = tech_analysis.get('atr_pct', 1.5)
                local_trend = tech_analysis.get('local_trend', 'neutral')

                # ========== 3. ДИНАМИЧЕСКИЙ ТРЕЙЛИНГ-СТОП НА ОСНОВЕ ATR ==========
                # Базовый откат = половина ATR (но не менее 0.3% и не более 2.5%)
                trailing_drawdown_pct = max(0.3, min(2.5, atr_pct * 0.5))

                # Корректировка по тренду
                if local_trend == position.side.value.lower():
                    # По тренду — можно больше (оставляем прибыль расти)
                    trailing_drawdown_pct = min(3.0, trailing_drawdown_pct * 1.5)
                    trend_bonus = f" (по тренду +50%)"
                else:
                    # Против тренда — фиксируем быстрее
                    trailing_drawdown_pct = max(0.3, trailing_drawdown_pct * 0.8)
                    trend_bonus = f" (против тренда -20%)"

                # Корректировка по волатильности рынка
                market_volatility = getattr(config, 'market_volatility', 0.01)
                if market_volatility > 0.02:
                    trailing_drawdown_pct *= 1.3
                    volatility_bonus = f" (рынок волатильный +30%)"
                elif market_volatility < 0.008:
                    trailing_drawdown_pct *= 0.7
                    volatility_bonus = f" (рынок спокойный -30%)"
                else:
                    volatility_bonus = ""

                # Ограничиваем финальное значение
                trailing_drawdown_pct = max(0.3, min(3.0, trailing_drawdown_pct))

                # ========== 4. ИНИЦИАЛИЗАЦИЯ И ОБНОВЛЕНИЕ МАКСИМУМОВ ==========
                if not hasattr(position, 'max_profit_pct'):
                    position.max_profit_pct = profit_pct
                    position.max_profit_time = get_moscow_time()
                    position.trailing_drawdown_pct = trailing_drawdown_pct

                    info(f"\n   📊 {position.ticker}: инициализирован трейлинг-стоп")
                    info(f"      📐 ATR: {atr_pct:.2f}%")
                    info(f"      🔻 Откат для срабатывания: {trailing_drawdown_pct:.2f}%{trend_bonus}{volatility_bonus}")
                    info(f"      📈 Текущий P&L: {profit_pct:+.2f}%")
                    if profit_pct > 0:
                        if position.side.value == "LONG":
                            stop_price = current_price * (1 - trailing_drawdown_pct / 100)
                        else:
                            stop_price = current_price * (1 + trailing_drawdown_pct / 100)
                        info(f"      🛑 Стоп-цена: {stop_price:.2f}₽")

                # Обновляем максимум прибыли
                if profit_pct > position.max_profit_pct:
                    old_max = position.max_profit_pct
                    position.max_profit_pct = profit_pct
                    position.max_profit_time = get_moscow_time()
                    position.trailing_drawdown_pct = trailing_drawdown_pct

                    # Рассчитываем новую стоп-цену
                    if position.side.value == "LONG":
                        stop_price = current_price * (1 - trailing_drawdown_pct / 100)
                    else:
                        stop_price = current_price * (1 + trailing_drawdown_pct / 100)

                    info(f"\n   📈 {position.ticker}: НОВЫЙ МАКСИМУМ ПРИБЫЛИ!")
                    info(f"      📊 Был: {old_max:+.2f}% → Стал: {profit_pct:+.2f}%")
                    info(f"      💰 Текущая цена: {current_price:.2f}₽")
                    info(f"      🔻 Откат для срабатывания: {trailing_drawdown_pct:.2f}%")
                    info(f"      🛑 Новый стоп: {stop_price:.2f}₽")

                    # Отправляем уведомление в Telegram при значительном обновлении
                    if profit_pct - old_max > 1.0:
                        try:
                            telegram = _get_telegram()
                            if telegram:
                                telegram.send_message(
                                    f"📈 **ОБНОВЛЕНИЕ МАКСИМУМА**\n\n"
                                    f"{position.ticker} ({position.side.value})\n"
                                    f"📊 P&L: {old_max:+.2f}% → {profit_pct:+.2f}%\n"
                                    f"💰 Цена: {entry_price:.2f}₽ → {current_price:.2f}₽\n"
                                    f"🛑 Стоп: {stop_price:.2f}₽ (откат {trailing_drawdown_pct:.1f}%)"
                                )
                        except Exception as e:
                            debug(f"   ⚠️ Ошибка отправки Telegram: {e}")

                # ========== 5. ПРОВЕРКА ОТКАТА ОТ МАКСИМУМА (ТРЕЙЛИНГ-СТОП) ==========
                if position.max_profit_pct > 1.0:  # Активируется только при прибыли >1%
                    drawdown = position.max_profit_pct - profit_pct
                    trailing_pct = getattr(position, 'trailing_drawdown_pct', trailing_drawdown_pct)

                    # Логируем текущий откат (каждые 0.1% изменения)
                    if drawdown > 0 and (not hasattr(position, '_last_drawdown_log') or
                                         abs(drawdown - position._last_drawdown_log) > 0.1):
                        position._last_drawdown_log = drawdown
                        debug(f"   📊 {position.ticker}: откат от максимума: {drawdown:.2f}% / {trailing_pct:.2f}% "
                              f"(макс: {position.max_profit_pct:+.2f}%, тек: {profit_pct:+.2f}%)")

                    if drawdown > trailing_pct:
                        warning(f"\n   {'⚠️' * 30}")
                        warning(f"   🎯 {position.ticker}: СРАБОТАЛ ТРЕЙЛИНГ-СТОП!")
                        warning(f"   {'⚠️' * 30}")
                        warning(f"      📈 Максимум P&L: {position.max_profit_pct:+.2f}%")
                        warning(f"      📉 Текущий P&L: {profit_pct:+.2f}%")
                        warning(f"      📉 Откат: {drawdown:.2f}% > {trailing_pct:.2f}%")
                        warning(f"      📊 ATR: {atr_pct:.2f}%")
                        warning(f"      💰 Цена входа: {entry_price:.2f}₽")
                        warning(f"      💰 Текущая цена: {current_price:.2f}₽")

                        # Закрываем позицию
                        try:
                            if position.side.value == "LONG":
                                success = _get_tbank().sell(figi, position.quantity, use_market=True)
                            else:
                                success = _get_tbank().buy(figi, position.quantity, use_market=True)

                            if success:
                                success(f"   ✅ {position.ticker} закрыт по трейлинг-стопу!")

                                # Отправляем уведомление в Telegram
                                try:
                                    telegram = _get_telegram()
                                    if telegram:
                                        telegram.send_message(
                                            f"🎯 **ТРЕЙЛИНГ-СТОП СРАБОТАЛ!**\n\n"
                                            f"{position.ticker} ({position.side.value})\n"
                                            f"📈 Максимум: {position.max_profit_pct:+.2f}%\n"
                                            f"📉 Закрыто: {profit_pct:+.2f}%\n"
                                            f"💰 Прибыль: {profit_pct:+.2f}%\n"
                                            f"🛑 Откат: {drawdown:.2f}%"
                                        )
                                except Exception:
                                    pass
                            else:
                                error(f"   ❌ Не удалось закрыть {position.ticker} по трейлинг-стопу")
                        except Exception as e:
                            error(f"   ❌ Ошибка при закрытии {position.ticker}: {e}")

                        position_manager.remove_position(figi)
                        continue

                # ========== 6. ДИНАМИЧЕСКИЕ ТЕЙК-ПРОФИТ И СТОП-ЛОСС ==========
                # Рассчитываем TP на основе ATR и локального тренда
                if local_trend == position.side.value.lower():
                    take_profit = atr_pct * 2.5
                    tp_reason = f"по тренду (2.5×ATR)"
                else:
                    take_profit = atr_pct * 1.2
                    tp_reason = f"против тренда (1.2×ATR)"

                take_profit = min(8.0, max(1.0, take_profit))
                stop_loss = atr_pct * 1.2

                # Проверяем ТЕЙК-ПРОФИТ
                if profit_pct >= take_profit:
                    info(f"\n   {'💰' * 30}")
                    info(f"   🎯 {position.ticker}: ТЕЙК-ПРОФИТ ДОСТИГНУТ!")
                    info(f"   {'💰' * 30}")
                    info(f"      📊 P&L: {profit_pct:.2f}% >= {take_profit:.2f}% ({tp_reason})")
                    info(f"      💰 Цена входа: {entry_price:.2f}₽")
                    info(f"      💰 Текущая цена: {current_price:.2f}₽")
                    info(f"      📈 Прибыль: {profit_pct:+.2f}%")

                    try:
                        if position.side.value == "LONG":
                            success = _get_tbank().sell(figi, position.quantity, use_market=True)
                        else:
                            success = _get_tbank().buy(figi, position.quantity, use_market=True)

                        if success:
                            success(f"   ✅ {position.ticker} закрыт по тейк-профиту!")
                        else:
                            error(f"   ❌ Не удалось закрыть {position.ticker} по тейк-профиту")
                    except Exception as e:
                        error(f"   ❌ Ошибка при закрытии {position.ticker}: {e}")

                    position_manager.remove_position(figi)
                    continue

                # Проверяем СТОП-ЛОСС
                if profit_pct <= -stop_loss:
                    warning(f"\n   {'🛑' * 30}")
                    warning(f"   🛑 {position.ticker}: СТОП-ЛОСС СРАБОТАЛ!")
                    warning(f"   {'🛑' * 30}")
                    warning(f"      📊 P&L: {profit_pct:.2f}% <= -{stop_loss:.2f}%")
                    warning(f"      💰 Цена входа: {entry_price:.2f}₽")
                    warning(f"      💰 Текущая цена: {current_price:.2f}₽")
                    warning(f"      📉 Убыток: {profit_pct:.2f}%")

                    try:
                        if position.side.value == "LONG":
                            success = _get_tbank().sell(figi, position.quantity, use_market=True)
                        else:
                            success = _get_tbank().buy(figi, position.quantity, use_market=True)

                        if success:
                            success(f"   ✅ {position.ticker} закрыт по стоп-лоссу")
                        else:
                            error(f"   ❌ Не удалось закрыть {position.ticker} по стоп-лоссу")
                    except Exception as e:
                        error(f"   ❌ Ошибка при закрытии {position.ticker}: {e}")

                    position_manager.remove_position(figi)
                    continue

            debug(f"   ✅ Позиции проверены")

        except Exception as e:
            error(f"   ❌ Ошибка проверки позиций: {e}")
            import traceback
            debug(f"      {traceback.format_exc()}")

    def show_trailing_stop_status(self):
        """Показать статус трейлинг-стопа для всех позиций"""
        from trading_bot.risk.position_manager import position_manager
        from trading_bot.api.tbank_client import tbank
        from ..config import config

        positions = position_manager.get_all_positions()
        if not positions:
            info("📭 Нет открытых позиций")
            return

        info(f"\n{'=' * 80}")
        info(f"📊 СТАТУС ТРЕЙЛИНГ-СТОПА")
        info(f"📅 Время: {get_moscow_time().strftime('%H:%M:%S')}")
        info(f"{'=' * 80}")

        for figi, position in positions.items():
            current_price = tbank.get_current_price(figi)
            if not current_price:
                continue

            if position.side.value == "LONG":
                profit_pct = (current_price - position.avg_price) / position.avg_price * 100
            else:
                profit_pct = (position.avg_price - current_price) / position.avg_price * 100

            # Получаем технический анализ
            tech_analysis = self._analyze_position_technicals(
                position.ticker, figi, position.side.value,
                current_price, position.avg_price
            )
            atr_pct = tech_analysis.get('atr_pct', 1.5)

            max_profit = getattr(position, 'max_profit_pct', profit_pct)
            drawdown = max_profit - profit_pct
            trailing_active = max_profit > 1.0
            trailing_pct = getattr(position, 'trailing_drawdown_pct', max(0.3, min(2.5, atr_pct * 0.5)))

            info(f"\n📌 {position.ticker} ({position.side.value}):")
            info(f"   💰 Текущий P&L: {profit_pct:+.2f}%")
            info(f"   📈 Максимум P&L: {max_profit:+.2f}%")
            info(f"   📉 Откат от максимума: {drawdown:.2f}%")
            info(f"   📊 ATR: {atr_pct:.2f}%")
            info(f"   🔻 Порог срабатывания: {trailing_pct:.2f}%")
            info(f"   🛡️ Трейлинг-стоп: {'✅ АКТИВЕН' if trailing_active else '⏸️ НЕ АКТИВЕН (ждём прибыль >1%)'}")

            if trailing_active:
                if position.side.value == "LONG":
                    stop_price = current_price * (1 - trailing_pct / 100)
                    info(f"   🔻 Стоп-цена: {stop_price:.2f}₽ (на {trailing_pct:.1f}% ниже текущей)")
                    info(f"   📈 До стопа: {((current_price - stop_price) / current_price * 100):.2f}%")
                else:
                    stop_price = current_price * (1 + trailing_pct / 100)
                    info(f"   🔻 Стоп-цена: {stop_price:.2f}₽ (на {trailing_pct:.1f}% выше текущей)")
                    info(f"   📈 До стопа: {((stop_price - current_price) / current_price * 100):.2f}%")

            # Прогноз
            if profit_pct < 0:
                info(f"   💡 Прогноз: позиция в минусе, трейлинг-стоп не активен")
            elif profit_pct < 1.0:
                need = 1.0 - profit_pct
                info(f"   💡 Прогноз: нужно ещё +{need:.2f}% для активации трейлинг-стопа")
            else:
                info(f"   💡 Прогноз: трейлинг-стоп защищает прибыль {profit_pct:+.2f}%")

        info(f"\n{'=' * 80}")
        info(f"📊 Рыночная волатильность: {getattr(config, 'market_volatility', 0.01) * 100:.2f}%")
        info(f"{'=' * 80}")

    def _log_status(self, total_capital: float, positions_count: int, margin_rate: float):
        """Логирование статуса"""
        exposure = self.get_market_exposure()
        max_positions = self.get_max_positions_by_capital(total_capital)

        info(f"\n{'=' * 60}")
        info(f"📊 ТОРГОВЫЙ ЦИКЛ #{self._cycle_count}")
        info(f"   💰 Капитал: {total_capital:.2f}₽")
        info(f"   📈 Позиций: {positions_count}/{max_positions}")
        info(f"   ⚖️ Баланс: LONG {exposure['long_pct'] * 100:.0f}% / SHORT {exposure['short_pct'] * 100:.0f}%")
        info(f"   📊 Маржа: {margin_rate:.1f}%")
        info(f"   🎯 TP: +{config.take_profit_pct:.1f}% | SL: -{config.stop_loss_pct:.2f}%")
        info(f"   🔻 SHORT: {'✅' if config.use_short else '❌'}")
        info(f"{'=' * 60}")

        # ========== ОБНОВЛЕНИЕ ВЕБ-СТАТУСА ==========
        try:
            # Пытаемся импортировать функцию обновления статуса
            import sys
            if 'web_server' in sys.modules:
                from web_server import update_bot_status
                update_bot_status(
                    running=self._running,
                    cycle_count=self._cycle_count,
                    positions=positions_count,
                    capital=total_capital
                )
                debug(f"   🌐 Веб-статус обновлён")
        except ImportError:
            debug(f"   ⏭️ web_server не доступен (не на Render)")
        except Exception as e:
            debug(f"   ⚠️ Ошибка обновления веб-статуса: {e}")

        # Существующий код с metrics
        if hasattr(self.bot, 'metrics') and self.bot.metrics:
            self.bot.metrics.update_portfolio(total_capital, total_capital, positions_count)
            self.bot.metrics.update_margin_rate(margin_rate)
            self.bot.metrics.update_cycle_count(self._cycle_count)

    # ==================== МУЛЬТИТАЙМФРЕЙМНЫЙ АНАЛИЗ ====================

    async def _get_multi_timeframe_candles(self, ticker: str, figi: str) -> Dict[str, List]:
        """
        Получение свечей для мультитаймфреймного анализа
        """
        from trading_bot.api.tbank_client import tbank
        from trading_bot.core.settings_manager import settings_manager

        candles_by_tf = {}

        if not settings_manager.is_multi_timeframe_enabled():
            candles_15min = tbank.get_candles(figi, days=2, interval_minutes=15)
            if candles_15min:
                candles_by_tf['15min'] = candles_15min
            return candles_by_tf

        tf_configs = [
            ('1min', 1, 1, 120),  # (таймфрейм, days, interval_minutes, лимит)
            ('5min', 2, 5, 120),
            ('15min', 2, 15, 100),
            ('1hour', 2, 60, 60)
        ]

        for tf_name, days, interval_min, limit in tf_configs:
            try:
                candles = tbank.get_candles(figi, days=days, interval_minutes=interval_min)

                if candles and len(candles) >= 20:
                    # ✅ ВОЗВРАЩАЕМ СЛОВАРИ (как ожидает multi_timeframe_analyzer)
                    result = []
                    for c in candles[-limit:]:
                        close = c[0]
                        volume = c[1] if len(c) > 1 else 0
                        result.append({
                            'close': close,
                            'volume': volume,
                            'high': close * 1.005,
                            'low': close * 0.995,
                            'open': close,
                        })
                    candles_by_tf[tf_name] = result
                    debug(f"      📊 {ticker}: загружено {len(result)} свечей ({tf_name})")
                else:
                    debug(f"      ⚠️ {ticker}: недостаточно свечей для {tf_name} ({len(candles) if candles else 0}/20)")
            except Exception as e:
                debug(f"      ❌ Ошибка загрузки {tf_name} для {ticker}: {e}")

        return candles_by_tf

    async def _analyze_ticker_with_mtf(self, ticker: str, figi: str,
                                       candles_15min: List,
                                       total_capital: float) -> Tuple[int, List[str], Dict]:
        """
        Анализ тикера с мультитаймфреймной поддержкой

        Args:
            ticker: Тикер для анализа
            figi: FIGI инструмента
            candles_15min: Свечи 15-минутного таймфрейма
            total_capital: Текущий капитал

        Returns:
            Tuple: (score, signals, mtf_details)
        """
        from trading_bot.core.settings_manager import settings_manager
        from trading_bot.config import config

        # Получаем свечи всех таймфреймов
        candles_by_tf = await self._get_multi_timeframe_candles(ticker, figi)

        # Если MTF выключен или нет данных 15min, используем только 15min
        if not settings_manager.is_multi_timeframe_enabled() or not candles_by_tf.get('15min'):
            # Стандартный анализ
            from trading_bot.analysis.strategy_engine import StrategyEngine
            strategy = StrategyEngine({})
            prices = [c.close for c in candles_15min]
            volumes = [c.volume for c in candles_15min]

            signal = strategy.analyze_signal(
                prices=prices,
                volumes=volumes,
                name=ticker,
                candles=candles_15min
            )
            return signal.score, signal.signals, {}

        # MTF анализ
        candles_1min = candles_by_tf.get('1min', [])
        candles_5min = candles_by_tf.get('5min', [])
        candles_15min_mtf = candles_by_tf.get('15min', candles_15min)
        candles_1hour = candles_by_tf.get('1hour', [])

        # Создаём стратегию с поддержкой MTF
        from trading_bot.analysis.strategy_engine import StrategyEngine

        strategy_config = {
            'use_multi_timeframe': settings_manager.is_multi_timeframe_enabled(),
            'mtf_boost': settings_manager.get_mtf_boost(),
            'mtf_min_confidence': settings_manager.get_mtf_min_confidence(),
            'mtf_consensus_bonus': settings_manager.get_mtf_consensus_bonus(),
            'tf_weights': settings_manager.get_tf_weights(),
            # Существующие параметры
            'rsi_period': 7,
            'score_threshold_long': settings_manager.get_score_threshold_long(),
            'score_threshold_short': settings_manager.get_score_threshold_short(),
            'take_profit_pct': config.take_profit_pct,
            'stop_loss_pct': config.stop_loss_pct,
            'trailing_stop_pct': config.trailing_stop_pct,
            'max_hold_minutes': config.adaptive_timeout_minutes,
            'use_supertrend': True,
            'use_ichimoku': True,
            'use_dmi_adx': True,
            'use_stochastic': True,
            'use_cci': True,
            'use_psar': True,
            'use_pivots': True,
            'use_vwap': True,
            'use_donchian': True,
            'use_obv': True,
            'use_aroon': True,
        }

        strategy = StrategyEngine(strategy_config)

        # Подготавливаем данные для анализа
        prices = [c.close for c in candles_15min_mtf]
        volumes = [c.volume for c in candles_15min_mtf]

        # Вызываем analyze_signal с MTF параметрами
        signal = strategy.analyze_signal(
            prices=prices,
            volumes=volumes,
            name=ticker,
            candles=candles_15min_mtf,
            candles_1min=candles_1min,
            candles_5min=candles_5min,
            candles_1hour=candles_1hour
        )

        # Добавляем MTF информацию в детали
        mtf_details = {}
        if hasattr(signal, 'mtf_details'):
            mtf_details = signal.mtf_details
        elif hasattr(strategy, '_last_mtf_details'):
            mtf_details = strategy._last_mtf_details

        # Логируем MTF результат при сильном сигнале
        if abs(signal.score) >= 3 and mtf_details:
            info(f"   📊 MTF {ticker}: {mtf_details.get('final', 'HOLD')} "
                 f"(1m={mtf_details.get('1min', '-')}, "
                 f"5m={mtf_details.get('5min', '-')}, "
                 f"15m={mtf_details.get('15min', '-')}, "
                 f"1h={mtf_details.get('1hour', '-')})")

        return signal.score, signal.signals, mtf_details

    def start(self):
        """Алиас для start_loop (для совместимости с bot.py)"""
        info("🔄 Вызван start() -> start_loop()")
        return self.start_loop()

    def cleanup_memory(self):
        """Принудительная очистка памяти"""
        import gc

        info("🧹 Очистка памяти...")

        if hasattr(self.bot, 'tbank'):
            self.bot.tbank._candles_cache.clear()
            self.bot.tbank._shares_cache = None
            self.bot.tbank._ticker_cache.clear()
            self.bot.tbank._margin_cache = None
            info("   ✅ Кэши TBankClient очищены")

        try:
            from trading_bot.core.candle_builder import candle_builder
            candle_builder.clear_cache()
            info("   ✅ Кэш свечей очищен")
        except:
            pass

        collected = gc.collect()
        info(f"   ✅ Сборщик мусора: собрано {collected} объектов")

        info("🧹 Память очищена")

